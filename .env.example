APP_ENV=development
APP_PORT=8080
METRICS_PORT=9091
GIN_MODE=debug
# Comma-separated proxy IPs/CIDRs. Keep empty when the app is directly exposed.
TRUSTED_PROXIES=

LOG_LEVEL=info
LOG_CONSOLE_FORMAT=text
LOG_FILE=logs/ecommerce.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=28
LOG_COMPRESS=true
LOG_ADD_SOURCE=false

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_HEADER_BYTES=1048576

PRODUCT_IMAGE_DIRECTORY=uploads/products
PRODUCT_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_WIDTH=6000
PRODUCT_IMAGE_MAX_HEIGHT=6000
PRODUCT_IMAGE_MAX_PIXELS=25000000
CLAMAV_ADDRESS=127.0.0.1:3310
CLAMAV_SCAN_TIMEOUT=15s

MYSQL_ROOT_PASSWORD=replace_with_secure_root_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=change_me_local
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m
DB_CONNECT_TIMEOUT=5s
DB_READ_TIMEOUT=10s
DB_WRITE_TIMEOUT=10s
DB_PING_TIMEOUT=5s

SESSION_SECRET=replace-with-a-random-secret
SESSION_SECURE=false
CSRF_SECRET=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES

# MailHog is for local development and tests only.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@ecommerce.local

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
