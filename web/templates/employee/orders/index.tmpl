{{define "employee/orders/index"}}{{template "layouts/employee/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" .DashboardURL "HomeLabel" "Dashboard" "Current" "Orders")}}{{template "partials/page-header" (dict "Title" "Orders" "Description" "Process fulfillment and shipping handovers.")}}<section class="table-toolbar"><form method="get" action="/employee/orders" class="row g-3 align-items-end"><div class="col-lg-4"><label class="form-label" for="employee-order-search">Search</label><input class="form-control" id="employee-order-search" name="user" value="{{.UserSearch}}" placeholder="Customer name or email"></div><div class="col-md-4 col-lg-3"><label class="form-label" for="employee-order-status">Status</label><select class="form-select" id="employee-order-status" name="status"><option value="">All statuses</option>{{range .Statuses}}<option value="{{.}}"{{if eq (printf "%s" .) $.SelectedStatus}} selected{{end}}>{{statusLabel .}}</option>{{end}}</select></div><div class="col-md-4 col-lg-3"><label class="form-label" for="employee-order-sort">Sort</label><select class="form-select" id="employee-order-sort" name="sort"><option value="id_desc"{{if eq .SelectedSort "id_desc"}} selected{{end}}>Newest</option><option value="id_asc"{{if eq .SelectedSort "id_asc"}} selected{{end}}>Oldest</option><option value="total_desc"{{if eq .SelectedSort "total_desc"}} selected{{end}}>Highest total</option><option value="total_asc"{{if eq .SelectedSort "total_asc"}} selected{{end}}>Lowest total</option></select></div><div class="col-md-4 col-lg-2 d-grid"><button class="btn btn-primary" type="submit">Apply</button></div></form></section><section class="content-card"><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>Order</th><th>Customer</th><th>Payment</th><th>Fulfillment</th><th>Shipping</th><th>Total</th><th>Created</th><th class="text-end">Actions</th></tr></thead><tbody>{{$root := .}}{{range .Orders}}<tr><td><strong>#{{.ID}}</strong></td><td>{{if .User.Name}}{{.User.Name}}{{else}}{{.User.Email}}{{end}}</td><td>{{if .Payment.ID}}{{template "partials/status-badge" .Payment.Status}}{{else}}—{{end}}</td><td>{{template "partials/status-badge" .Status}}</td><td>{{if .Shipment.ID}}{{template "partials/status-badge" .Shipment.Status}}{{else}}Not created{{end}}</td><td>{{money .TotalCents}}</td><td><time datetime="{{.CreatedAt.Format "2006-01-02"}}">{{.CreatedAt.Format "02.01.2006"}}</time></td><td class="text-end">{{template "employee/orders/actions" (dict "Order" . "CSRF" $root.CSRFField)}}</td></tr>{{else}}<tr><td colspan="8">{{template "partials/empty-state" (dict "Title" "No orders found." "Description" "Try changing the filters.")}}</td></tr>{{end}}</tbody></table></div></section>{{template "layouts/employee/end" .}}{{end}}
