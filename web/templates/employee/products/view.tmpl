{{define "employee/products/view"}}{{template "layouts/employee/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/employee/dashboard" "HomeLabel" "Dashboard" "ParentURL" "/employee/products" "ParentLabel" "Products" "Current" .Product.Name)}}{{template "partials/page-header" (dict "Title" .Product.Name "Description" "Product details and inventory." "ActionURL" (printf "/employee/products/%d/edit" .Product.ID) "ActionLabel" "Edit Product")}}<section class="content-card"><div class="row g-4"><div class="col-md-4">{{if .Product.ImageFilename}}<img class="img-fluid rounded-4" src="/media/products/{{.Product.ImageFilename}}" alt="{{.Product.Name}}">{{else}}<div class="empty-state">No image</div>{{end}}</div><div class="col-md-8"><dl class="row mb-0"><dt class="col-sm-4">SKU</dt><dd class="col-sm-8">{{primarySKU .Product.Variants}}</dd><dt class="col-sm-4">Category</dt><dd class="col-sm-8">{{if .Product.Category}}{{.Product.Category.Name}}{{else}}—{{end}}</dd><dt class="col-sm-4">Price</dt><dd class="col-sm-8">{{money .Product.PriceCents}}</dd><dt class="col-sm-4">Stock</dt><dd class="col-sm-8">{{.Product.Stock}}</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">{{if .Product.Active}}<span class="status-badge status-active">Active</span>{{else}}<span class="status-badge status-inactive">Inactive</span>{{end}}</dd><dt class="col-sm-4">Description</dt><dd class="col-sm-8">{{.Product.Description}}</dd></dl></div></div></section>{{template "layouts/employee/end" .}}{{end}}
