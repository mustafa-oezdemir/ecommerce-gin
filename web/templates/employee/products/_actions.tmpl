{{define "employee/products/actions"}}<div class="action-buttons"><a class="btn btn-sm btn-outline-secondary" href="/employee/products/{{.Product.ID}}">View</a><a class="btn btn-sm btn-outline-primary" href="/employee/products/{{.Product.ID}}/edit">Edit</a>{{if .Product.Active}}<form method="post" action="/employee/products/{{.Product.ID}}/deactivate">{{.CSRF}}<button class="btn btn-sm btn-outline-danger" type="submit">Deactivate</button></form>{{else}}<form method="post" action="/employee/products/{{.Product.ID}}/activate">{{.CSRF}}<button class="btn btn-sm btn-outline-success" type="submit">Activate</button></form>{{end}}</div>{{end}}
