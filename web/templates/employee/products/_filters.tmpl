{{define "employee/products/filters"}}<section class="table-toolbar"><form method="get" action="/employee/products" class="row g-3 align-items-end"><div class="col-lg-4"><label class="form-label" for="product-search">Search</label><input class="form-control" id="product-search" name="q" value="{{.Search}}" maxlength="100" placeholder="Product name"></div><div class="col-md-4 col-lg-3"><label class="form-label" for="product-category">Category</label><select class="form-select" id="product-category" name="category_id"><option value="">All categories</option>{{range .Categories}}<option value="{{.ID}}"{{if eq .ID $.SelectedCategoryID}} selected{{end}}>{{.Name}}</option>{{end}}</select></div><div class="col-md-4 col-lg-2"><label class="form-label" for="product-stock">Stock</label><select class="form-select" id="product-stock" name="stock_status"><option value="all">All stock</option><option value="low"{{if eq .SelectedStockStatus "low"}} selected{{end}}>Low stock</option></select></div><div class="col-md-4 col-lg-2"><label class="form-label" for="product-availability">Availability</label><select class="form-select" id="product-availability" name="availability"><option value="all"{{if eq .SelectedAvailability "all"}} selected{{end}}>All</option><option value="active"{{if eq .SelectedAvailability "active"}} selected{{end}}>Active</option><option value="inactive"{{if eq .SelectedAvailability "inactive"}} selected{{end}}>Inactive</option></select></div><div class="col-lg-1 d-grid"><button class="btn btn-primary" type="submit">Filter</button></div></form></section>{{end}}
