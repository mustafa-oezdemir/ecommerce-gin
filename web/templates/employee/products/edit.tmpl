{{define "employee/products/edit"}}{{template "layouts/employee/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/employee/dashboard" "HomeLabel" "Dashboard" "ParentURL" "/employee/products" "ParentLabel" "Products" "Current" "Edit")}}{{template "partials/page-header" (dict "Title" "Edit Product" "Description" .Product.Name)}}<section class="form-card mb-4">{{template "employee/products/form" (dict "Action" (printf "/employee/products/%d" .Product.ID) "Product" .Product "Categories" .Categories "CSRF" .CSRFField "Editing" true)}}</section><section class="content-card"><h2 class="h5">Product images</h2><form method="post" action="/employee/products/{{.Product.ID}}/images" enctype="multipart/form-data" class="row g-3 align-items-end mb-4">{{.CSRFField}}<div class="col-md-9"><label class="form-label" for="more-images">Add images</label><input class="form-control" id="more-images" type="file" name="images" accept="image/jpeg,image/png" multiple required></div><div class="col-md-3 d-grid"><button class="btn btn-primary" type="submit">Upload</button></div></form><div class="row g-3">{{range .Product.Images}}<div class="col-sm-6 col-lg-4"><div class="border rounded-4 p-2"><img class="img-fluid rounded-3 mb-2" src="/media/products/{{.Filename}}" alt=""><div class="d-flex gap-2">{{if ne .Filename $.Product.ImageFilename}}<form method="post" action="/employee/products/{{$.Product.ID}}/images/{{.ID}}/cover">{{$.CSRFField}}<button class="btn btn-sm btn-outline-primary">Set cover</button></form>{{else}}<span class="status-badge status-active">Cover</span>{{end}}<form method="post" action="/employee/products/{{$.Product.ID}}/images/{{.ID}}/delete">{{$.CSRFField}}<button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div>{{else}}<p class="text-muted">No images uploaded.</p>{{end}}</div></section>{{template "layouts/employee/end" .}}{{end}}
