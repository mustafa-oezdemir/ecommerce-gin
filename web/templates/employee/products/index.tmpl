{{define "employee/products/index"}}{{template "layouts/employee/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" .DashboardURL "HomeLabel" "Dashboard" "Current" "Products")}}{{template "partials/flash-messages" .}}{{template "partials/page-header" (dict "Title" "Products" "Description" "Manage catalog details, availability and inventory." "ActionURL" "/employee/products/new" "ActionLabel" "+ Add Product")}}{{template "employee/products/filters" .}}<section class="content-card"><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>Image</th><th>Product</th><th>SKU</th><th>Category</th><th>Price</th><th>Stock</th><th class="text-end">Actions</th></tr></thead><tbody>{{$root := .}}{{range .Products}}<tr><td>{{if .ImageFilename}}<img class="table-product-image" src="/media/products/{{.ImageFilename}}" alt="">{{else}}<span class="table-product-image table-product-placeholder" aria-hidden="true">{{initials .Name}}</span>{{end}}</td><td><strong>{{.Name}}</strong><div>{{if .Active}}<span class="status-badge status-active">Active</span>{{else}}<span class="status-badge status-inactive">Inactive</span>{{end}}</div></td><td>{{primarySKU .Variants}}</td><td>{{if .Category}}{{.Category.Name}}{{else}}—{{end}}</td><td>{{money .PriceCents}}</td><td>{{if eq .Stock 0}}<span class="status-badge status-failed">Out of Stock</span>{{else if le .Stock 5}}<span class="status-badge status-preparing">Low Stock · {{.Stock}}</span>{{else}}<span class="status-badge status-delivered">In Stock · {{.Stock}}</span>{{end}}</td><td class="text-end">{{template "employee/products/actions" (dict "Product" . "CSRF" $root.CSRFField)}}</td></tr>{{else}}<tr><td colspan="7">{{template "partials/empty-state" (dict "Title" "No products found." "Description" "Change the filters or add a product." "ActionURL" "/employee/products/new" "ActionLabel" "Add Product")}}</td></tr>{{end}}</tbody></table></div></section>{{template "layouts/employee/end" .}}{{end}}
