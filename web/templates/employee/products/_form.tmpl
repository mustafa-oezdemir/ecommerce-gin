{{define "employee/products/form"}}<form method="post" action="{{.Action}}" enctype="multipart/form-data" class="row g-3">{{.CSRF}}<div class="col-md-7"><label class="form-label" for="product-name">Name</label><input class="form-control" id="product-name" name="name" value="{{.Product.Name}}" maxlength="200" required></div><div class="col-md-5"><label class="form-label" for="product-category-form">Category</label><select class="form-select" id="product-category-form" name="category_id"><option value="0">No category</option>{{range .Categories}}<option value="{{.ID}}"{{if $.Product.Category}}{{if eq .ID $.Product.Category.ID}} selected{{end}}{{end}}>{{.Name}}</option>{{end}}</select></div><div class="col-md-4"><label class="form-label" for="product-price">Price (€)</label><input class="form-control" id="product-price" name="price" inputmode="decimal" value="{{priceInput .Product.PriceCents}}" required></div><div class="col-md-4"><label class="form-label" for="product-stock-form">Stock</label><input class="form-control" id="product-stock-form" type="number" name="stock" min="0" value="{{.Product.Stock}}" required></div>{{if not .Editing}}<div class="col-md-4"><label class="form-label" for="product-images">Images</label><input class="form-control" id="product-images" type="file" name="images" accept="image/jpeg,image/png" multiple></div>{{end}}<div class="col-12"><label class="form-label" for="product-description">Description</label><textarea class="form-control" id="product-description" name="description" rows="5">{{.Product.Description}}</textarea></div><div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="/employee/products">Cancel</a><button class="btn btn-primary" type="submit">{{if .Editing}}Save changes{{else}}Create product{{end}}</button></div></form>{{end}}
