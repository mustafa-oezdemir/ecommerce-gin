{{define "employee/dashboard/index"}}{{template "layouts/employee/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/employee/dashboard" "HomeLabel" "Dashboard" "Current" "Overview")}}{{template "partials/page-header" (dict "Title" "Employee Dashboard" "Description" "Orders, fulfillment and inventory at a glance.")}}<div class="row g-4"><div class="col-md-6 col-xl-3"><a class="card stat-card stat-card-link h-100" href="/employee/orders?status=pending" aria-label="View {{.PendingOrders}} pending orders"><div class="card-body"><span class="text-muted small">Pending</span><div class="display-6 fw-bold mt-2">{{.PendingOrders}}</div></div></a></div>{{template "dashboard/stat" (dict "Label" "Processing" "Value" .ProcessingOrders)}}<div class="col-md-6 col-xl-3"><a class="card stat-card stat-card-link h-100" href="/employee/products?stock_status=low" aria-label="View {{.LowStockProducts}} low-stock products"><div class="card-body"><span class="text-muted small">Low Stock</span><div class="display-6 fw-bold mt-2">{{.LowStockProducts}}</div></div></a></div>{{template "dashboard/stat" (dict "Label" "Out of Stock" "Value" .OutOfStockProducts)}}</div>{{template "layouts/employee/end" .}}{{end}}
