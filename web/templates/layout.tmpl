{{define "site-brand"}}<span class="brand-pehli">Pehli</span><span class="brand-one">One</span>{{end}}

{{define "site-nav"}}
<header class="site-header">
  <nav class="navbar navbar-expand site-navbar" aria-label="Primary navigation">
    <div class="container site-nav-container">
      <a class="navbar-brand site-brand" href="/" aria-label="PehliOne home">{{template "site-brand" .}}</a>
      <div class="site-nav-links ms-auto">
        {{if .CurrentUser}}
          {{if eq .CurrentUser.Role "admin"}}
            <a class="site-nav-link" href="/admin/users">Users</a>
            <a class="site-nav-link" href="/admin/orders">Orders</a>
            <a class="site-nav-link" href="/admin/categories">Categories</a>
            <a class="site-nav-link" href="/admin/logs">Logs</a>
          {{else if eq .CurrentUser.Role "employee"}}
            <a class="site-nav-link" href="/employee/products">Products</a>
            <a class="site-nav-link" href="/employee/orders">Orders</a>
          {{else}}
            <a class="site-nav-link" href="/">Products</a>
            <a class="site-nav-link" href="/cart">Cart</a>
          {{end}}
          <details class="account-dropdown">
            <summary class="account-trigger">
              <span class="account-trigger-label">Account</span>
              <span class="account-avatar" aria-hidden="true">{{if .CurrentUser.Name}}{{initials .CurrentUser.Name}}{{else}}A{{end}}</span>
            </summary>
            <div class="account-dropdown-menu" role="group" aria-label="Account menu">
              <div class="account-dropdown-header">
                <span class="account-avatar account-avatar-large" aria-hidden="true">{{if .CurrentUser.Name}}{{initials .CurrentUser.Name}}{{else}}A{{end}}</span>
                <span>
                  <strong>{{if .CurrentUser.Name}}{{.CurrentUser.Name}}{{else}}Your account{{end}}</strong>
                  <small>{{.CurrentUser.Email}}</small>
                </span>
              </div>
              {{if eq .CurrentUser.Role "admin"}}
                <a class="account-dropdown-link" href="/admin/dashboard">Admin dashboard</a>
                <a class="account-dropdown-link" href="/">Store</a>
              {{else if eq .CurrentUser.Role "employee"}}
                <a class="account-dropdown-link" href="/employee/dashboard">Employee dashboard</a>
                <a class="account-dropdown-link" href="/">Store</a>
              {{else}}
                <a class="account-dropdown-link" href="/account">Profile & security</a>
                <a class="account-dropdown-link" href="/account/orders">Orders</a>
                <a class="account-dropdown-link" href="/account/lists">Lists</a>
              {{end}}
              <div class="account-dropdown-divider"></div>
              <form method="post" action="/logout">
                {{.CSRFField}}
                <button class="account-dropdown-action" type="submit">Log out</button>
              </form>
            </div>
          </details>
        {{else}}
          <a class="site-nav-link" href="/">Products</a>
          <a class="btn btn-sm btn-brand" href="/login">Log in</a>
        {{end}}
      </div>
    </div>
  </nav>
</header>
{{end}}

{{define "site-footer"}}
<footer class="site-footer">
  <div class="container site-footer-inner">
    <a class="site-brand site-brand-footer" href="/" aria-label="PehliOne home">{{template "site-brand" .}}</a>
    <p class="mb-0">Secure shopping, simple account management, and reliable delivery.</p>
    <span class="site-footer-meta">Built with Go</span>
  </div>
</footer>
{{end}}

{{define "layout"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{block "title" .}}PehliOne{{end}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
</head>
<body>
  {{template "site-nav" .}}
  <main class="app-main container py-5">
    {{block "content" .}}{{end}}
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
