{{define "site-brand"}}<span class="brand-pehli">Pehli</span><span class="brand-one">One</span>{{end}}

{{define "site-nav"}}
<header class="site-header">
  <nav class="navbar navbar-expand site-navbar" aria-label="Primary navigation">
    <div class="container site-nav-container">
      <a class="navbar-brand site-brand" href="/" aria-label="PehliOne home">{{template "site-brand" .}}</a>
      <div class="site-nav-links ms-auto">
        {{if .CurrentUser}}
          {{if eq .CurrentUser.Role "admin"}}
            <a class="site-nav-link" href="/admin/dashboard">Dashboard</a>
            <a class="site-nav-link" href="/admin/users">Users</a>
            <a class="site-nav-link" href="/admin/orders">Orders</a>
            <a class="site-nav-link" href="/admin/categories">Categories</a>
            <a class="site-nav-link" href="/admin/logs">Logs</a>
            <a class="site-nav-link" href="/">Store</a>
          {{else if eq .CurrentUser.Role "employee"}}
            <a class="site-nav-link" href="/employee/dashboard">Dashboard</a>
            <a class="site-nav-link" href="/employee/products">Products</a>
            <a class="site-nav-link" href="/employee/orders">Orders</a>
            <a class="site-nav-link" href="/">Store</a>
          {{else}}
            <a class="site-nav-link" href="/">Products</a>
            <a class="site-nav-link" href="/cart">Cart</a>
            <a class="site-nav-link" href="/account/orders">Orders</a>
            <a class="site-nav-link" href="/account/lists">Lists</a>
            <a class="site-nav-link" href="/account">Account</a>
          {{end}}
          <form class="site-logout" method="post" action="/logout">
            {{.CSRFField}}
            <button class="btn btn-sm btn-dark" type="submit">Log out</button>
          </form>
        {{else}}
          <a class="site-nav-link" href="/">Products</a>
          <a class="btn btn-sm btn-brand" href="/login">Log in</a>
        {{end}}
      </div>
    </div>
  </nav>
</header>
{{end}}

{{define "site-footer"}}
<footer class="site-footer">
  <div class="container site-footer-inner">
    <a class="site-brand site-brand-footer" href="/" aria-label="PehliOne home">{{template "site-brand" .}}</a>
    <p class="mb-0">Secure shopping, simple account management, and reliable delivery.</p>
    <span class="site-footer-meta">Built with Go</span>
  </div>
</footer>
{{end}}

{{define "layout"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{block "title" .}}PehliOne{{end}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
</head>
<body>
  {{template "site-nav" .}}
  <main class="app-main container py-5">
    {{block "content" .}}{{end}}
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
