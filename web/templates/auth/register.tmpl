{{define "auth/register"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create account | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
  <script src="/static/site-ui.js" defer></script>
</head>
<body class="auth-page">
  {{template "site-nav" .}}
  <main class="app-main container py-5 d-flex align-items-center">
    <section class="auth-shell mx-auto" aria-labelledby="register-title">
      <aside class="auth-intro">
        <a class="site-brand auth-brand" href="/" aria-label="PehliOne home">{{template "site-brand" .}}</a>
        <span class="auth-kicker">Join PehliOne</span>
        <h1>Everything you love, one account away.</h1>
        <p>Create your free customer account to check out faster and keep every order in one place.</p>
        <ul class="auth-benefits">
          <li><span aria-hidden="true">✓</span> Secure checkout and saved addresses</li>
          <li><span aria-hidden="true">✓</span> Live delivery and return tracking</li>
          <li><span aria-hidden="true">✓</span> Wish lists and product reviews</li>
        </ul>
      </aside>

      <div class="auth-form-panel">
        <div class="mb-4">
          <span class="auth-kicker">Create account</span>
          <h2 class="h3 mb-2" id="register-title">Start shopping with us</h2>
          <p class="text-muted mb-0">It only takes a minute.</p>
        </div>

        {{if .error}}
        <div class="alert alert-danger" role="alert">{{.error}}</div>
        {{end}}

        <form method="post" action="/register">
          {{.CSRFField}}
          <div class="row g-3">
            <div class="col-sm-6">
              <label class="form-label" for="first-name">First name</label>
              <input class="form-control form-control-lg" id="first-name" name="first_name" value="{{.FirstName}}" maxlength="100" autocomplete="given-name" required>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="last-name">Last name</label>
              <input class="form-control form-control-lg" id="last-name" name="last_name" value="{{.LastName}}" maxlength="100" autocomplete="family-name" required>
            </div>
            <div class="col-12">
              <label class="form-label" for="register-email">Email address</label>
              <input class="form-control form-control-lg" id="register-email" type="email" name="email" value="{{.Email}}" maxlength="254" autocomplete="email" placeholder="you@example.com" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="register-password">Password</label>
              <input class="form-control form-control-lg" id="register-password" type="password" name="password" minlength="12" maxlength="72" autocomplete="new-password" aria-describedby="password-help" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="password-confirmation">Confirm password</label>
              <input class="form-control form-control-lg" id="password-confirmation" type="password" name="password_confirmation" minlength="12" maxlength="72" autocomplete="new-password" required>
            </div>
            <div class="col-12">
              <div class="form-text mt-0" id="password-help">Use 12–72 characters. A longer, unique passphrase works best.</div>
            </div>
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input" id="accept-terms" type="checkbox" name="accept_terms" value="true" required>
                <label class="form-check-label" for="accept-terms">I agree to the Terms of Service and Privacy Policy.</label>
              </div>
            </div>
            <div class="col-12 d-grid mt-4">
              <button class="btn btn-primary btn-lg" type="submit">Create my account</button>
            </div>
          </div>
        </form>
        <p class="auth-switch text-center mb-0 mt-4">Already have an account? <a href="/login">Log in</a></p>
      </div>
    </section>
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
