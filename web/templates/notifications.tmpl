{{ define "notifications.tmpl" }}
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Notifications | PehliOne</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link href="/static/site.css" rel="stylesheet">
	</head>
	<body>
		{{ template "site-nav" . }}
		<main class="app-main container py-5">
			<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
				<div><span class="badge bg-primary-subtle text-primary rounded-pill">Account</span><h1 class="h2 mt-2 mb-0">Notifications</h1></div>
				<form method="post" action="/account/notifications/read-all">{{ .CSRFField }}<button class="btn btn-outline-primary" type="submit">Mark all as read</button></form>
			</div>
			<div class="list-group shadow-sm">
				{{ range .Notifications }}
					<article class="list-group-item list-group-item-action p-4{{ if not .IsRead }} bg-primary-subtle{{ end }}">
						<div class="d-flex justify-content-between gap-3">
							<div><h2 class="h5 mb-1">{{ .Title }}</h2><p class="mb-2">{{ .Message }}</p><a href="/account/orders/{{ .RelatedOrderID }}">View order #{{ .RelatedOrderID }}</a></div>
							<div class="text-end">
								<time class="small text-muted">{{ .CreatedAt.Format "02 Jan 2006 15:04" }}</time>
								{{ if not .IsRead }}
									<form method="post" action="/account/notifications/{{ .ID }}/read" class="mt-2">{{ $.CSRFField }}
										<button class="btn btn-sm btn-primary" type="submit">Mark read</button>
									</form>
								{{ end }}</div>
						</div>
					</article>
				{{ else }}
        <div class="list-group-item p-4 text-muted">You have no notifications.</div>
				{{ end }}
			</div>
		</main>
		{{ template "site-footer" . }}
	</body>
</html>
{{ end }}
