{{define "employee_products.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Product Management | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .panel-card { border: 0; border-radius: 1.2rem; box-shadow: 0 12px 28px rgba(15,23,42,0.08); }
    .product-thumbnail { width: 64px; height: 64px; border-radius: .9rem; object-fit: cover; background: #eef2ff; }
    .image-manager { min-width: 290px; }
    .image-tile { width: 76px; }
    .image-tile img { width: 76px; height: 76px; border-radius: .85rem; object-fit: cover; }
    .image-tile-cover img { outline: 3px solid #f97316; outline-offset: 2px; }
    .image-actions { display: grid; gap: .3rem; }
  </style>
</head>
<body>
  {{template "site-nav" .}}

  <main class="app-main container py-5">
    <div class="row g-4">
      {{if .Success}}
      <div class="col-12"><div class="alert alert-success mb-0" role="status">{{.Success}}</div></div>
      {{end}}
      <div class="col-lg-4">
        <div class="card panel-card h-100">
          <div class="card-body p-4">
            <h1 class="h4 mb-3">New Product</h1>
            <form method="post" action="/employee/products" enctype="multipart/form-data">
              {{.CSRFField}}
              <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" name="name" placeholder="Name" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Description</label>
                <input class="form-control" name="description" placeholder="Description">
              </div>
              <div class="row g-2">
                <div class="col-6">
                  <label class="form-label">Price</label>
                  <input class="form-control" name="price" placeholder="19.99" required>
                </div>
                <div class="col-6">
                  <label class="form-label">Stock</label>
                  <input class="form-control" type="number" min="0" name="stock" value="0" required>
                </div>
              </div>
              <div class="mt-3">
                <label class="form-label">Category</label>
                <select class="form-select" name="category_id">
                  <option value="">No category</option>
                  {{range .Categories}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
                </select>
              </div>
              <div class="mt-3">
                <label class="form-label" for="new-product-images">Product images</label>
                <input class="form-control" id="new-product-images" type="file" name="images" accept=".jpg,.jpeg,.png,image/jpeg,image/png" multiple>
                <div class="form-text">Choose up to {{.ImageLimit}} JPEG or PNG files. Each file can be up to {{.ImageMaxMB}} MB and is virus-scanned and sanitized.</div>
              </div>
              <button type="submit" class="btn btn-primary mt-3">Add Product</button>
            </form>
          </div>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="card panel-card">
          <div class="card-body p-4">
            <h2 class="h4 mb-3">Product Management</h2>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead>
                  <tr><th>Image</th><th>Name</th><th>Price</th><th>Stock</th><th>Active</th></tr>
                </thead>
                <tbody>
                  {{range .Products}}
                  <tr>
                    <td class="image-manager">
                      {{$product := .}}
                      {{if .Images}}
                      <div class="d-flex flex-wrap gap-3 mb-3">
                        {{range .Images}}
                        <div class="image-tile {{if eq .Filename $product.ImageFilename}}image-tile-cover{{end}}">
                          <img src="/media/products/{{.Filename}}" alt="{{if eq .Filename $product.ImageFilename}}Cover image for {{end}}{{$product.Name}}" loading="lazy">
                          <div class="image-actions mt-2">
                            {{if eq .Filename $product.ImageFilename}}
                            <span class="badge rounded-pill text-bg-dark">Cover</span>
                            {{else}}
                            <form method="post" action="/employee/products/{{$product.ID}}/images/{{.ID}}/cover">
                              {{$.CSRFField}}
                              <button type="submit" class="btn btn-sm btn-outline-primary w-100">Set cover</button>
                            </form>
                            {{end}}
                            <form method="post" action="/employee/products/{{$product.ID}}/images/{{.ID}}/delete">
                              {{$.CSRFField}}
                              <button type="submit" class="btn btn-sm btn-outline-danger w-100">Delete</button>
                            </form>
                          </div>
                        </div>
                        {{end}}
                      </div>
                      {{else}}
                      <div class="product-thumbnail d-flex align-items-center justify-content-center text-primary fw-bold mb-2">{{if .Category}}{{initials .Category.Name}}{{else}}N{{end}}</div>
                      {{end}}
                      {{if lt (len .Images) $.ImageLimit}}
                      <form method="post" action="/employee/products/{{.ID}}/images" enctype="multipart/form-data" class="d-grid gap-2">
                        {{$.CSRFField}}
                        <input class="form-control form-control-sm" type="file" name="images" accept=".jpg,.jpeg,.png,image/jpeg,image/png" multiple required aria-label="Images for {{.Name}}">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                          <small class="text-muted">{{len .Images}} / {{$.ImageLimit}} images</small>
                          <button type="submit" class="btn btn-sm btn-outline-secondary">Add images</button>
                        </div>
                      </form>
                      {{else}}
                      <small class="text-muted">Image limit reached ({{$.ImageLimit}} / {{$.ImageLimit}}).</small>
                      {{end}}
                    </td>
                    <td>{{.Name}}</td>
                    <td>{{money .PriceCents}}</td>
                    <td>
                      <form method="post" action="/employee/products/{{.ID}}/stock" class="d-flex gap-2 align-items-center">
                        {{$.CSRFField}}
                        <input class="form-control" name="stock" type="number" min="0" value="{{.Stock}}" style="max-width: 110px;">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                      </form>
                    </td>
                    <td><span class="badge bg-success-subtle text-success">{{.Active}}</span></td>
                  </tr>
                  {{else}}
                  <tr><td colspan="5" class="text-muted">No products found.</td></tr>
                  {{end}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
