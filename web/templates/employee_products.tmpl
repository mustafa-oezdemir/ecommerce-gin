{{define "employee_products.tmpl"}}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ürün Yönetimi | NordShop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .panel-card { border: 0; border-radius: 1.2rem; box-shadow: 0 12px 28px rgba(15,23,42,0.08); }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/employee">Çalışan</a>
      <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/employee/products">Ürünler</a>
        <a class="btn btn-outline-light btn-sm" href="/employee/orders">Siparişler</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="card panel-card h-100">
          <div class="card-body p-4">
            <h1 class="h4 mb-3">Yeni ürün</h1>
            <form method="post" action="/employee/products">
              {{.CSRFField}}
              <div class="mb-3">
                <label class="form-label">Ad</label>
                <input class="form-control" name="name" placeholder="Ad" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <input class="form-control" name="description" placeholder="Açıklama">
              </div>
              <div class="row g-2">
                <div class="col-6">
                  <label class="form-label">Fiyat</label>
                  <input class="form-control" name="price" placeholder="19.99" required>
                </div>
                <div class="col-6">
                  <label class="form-label">Stok</label>
                  <input class="form-control" type="number" min="0" name="stock" value="0" required>
                </div>
              </div>
              <div class="mt-3">
                <label class="form-label">Kategori</label>
                <select class="form-select" name="category_id">
                  <option value="">Kategori yok</option>
                  {{range .Categories}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
                </select>
              </div>
              <button type="submit" class="btn btn-primary mt-3">Ürün ekle</button>
            </form>
          </div>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="card panel-card">
          <div class="card-body p-4">
            <h2 class="h4 mb-3">Ürün yönetimi</h2>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead>
                  <tr><th>Ad</th><th>Fiyat</th><th>Stok</th><th>Aktif</th></tr>
                </thead>
                <tbody>
                  {{range .Products}}
                  <tr>
                    <td>{{.Name}}</td>
                    <td>{{money .PriceCents}}</td>
                    <td>
                      <form method="post" action="/employee/products/{{.ID}}/stock" class="d-flex gap-2 align-items-center">
                        {{$.CSRFField}}
                        <input class="form-control" name="stock" type="number" min="0" value="{{.Stock}}" style="max-width: 110px;">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Güncelle</button>
                      </form>
                    </td>
                    <td><span class="badge bg-success-subtle text-success">{{.Active}}</span></td>
                  </tr>
                  {{else}}
                  <tr><td colspan="4" class="text-muted">Ürün bulunamadı.</td></tr>
                  {{end}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
{{end}}
