{{define "employee_products.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Product Management | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .panel-card { border: 0; border-radius: 1.2rem; box-shadow: 0 12px 28px rgba(15,23,42,0.08); }
    .product-thumbnail { width: 56px; height: 56px; border-radius: .8rem; object-fit: cover; background: #eef2ff; }
    .toggle-card > summary { cursor: pointer; list-style: none; }
    .toggle-card > summary::-webkit-details-marker { display: none; }
    .image-tile { width: 88px; }
    .image-tile img { width: 88px; height: 88px; border-radius: .85rem; object-fit: cover; }
    .image-tile-cover img { outline: 3px solid #f97316; outline-offset: 2px; }
    .image-actions { display: grid; gap: .3rem; }
  </style>
</head>
<body>
  {{template "site-nav" .}}

  <main class="app-main container py-5">
    {{if .Success}}<div class="alert alert-success" role="status">{{.Success}}</div>{{end}}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <h1 class="h3 mb-1">Product Management</h1>
        <p class="text-muted mb-0">Find products and manage their details.</p>
      </div>
      <span class="badge rounded-pill text-bg-light">{{len .Products}} products</span>
    </div>

    <details class="card panel-card toggle-card mb-4" id="new-product">
      <summary class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
        <span class="fw-semibold">New Product</span>
        <span class="btn btn-primary btn-sm">Add product</span>
      </summary>
      <div class="card-body border-top p-4">
        <form method="post" action="/employee/products" enctype="multipart/form-data">
          {{.CSRFField}}
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="new-product-name">Name</label>
              <input class="form-control" id="new-product-name" name="name" maxlength="200" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="new-product-category">Category</label>
              <select class="form-select" id="new-product-category" name="category_id">
                <option value="">No category</option>
                {{range .Categories}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
              </select>
            </div>
            <div class="col-12">
              <label class="form-label" for="new-product-description">Description</label>
              <textarea class="form-control" id="new-product-description" name="description" rows="3" maxlength="5000"></textarea>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="new-product-price">Price</label>
              <input class="form-control" id="new-product-price" name="price" placeholder="19.99" required>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="new-product-stock">Stock</label>
              <input class="form-control" id="new-product-stock" type="number" min="0" name="stock" value="0" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="new-product-images">Product images</label>
              <input class="form-control" id="new-product-images" type="file" name="images" accept=".jpg,.jpeg,.png,image/jpeg,image/png" multiple>
              <div class="form-text">Up to {{.ImageLimit}} JPEG or PNG files, {{.ImageMaxMB}} MB each.</div>
            </div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Create Product</button></div>
          </div>
        </form>
      </div>
    </details>

    {{with .EditProduct}}
    {{$product := .}}
    <section class="card panel-card mb-4" id="edit-product">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
          <div><span class="text-muted small">Editing</span><h2 class="h4 mb-0">{{.Name}}</h2></div>
          <a class="btn btn-sm btn-outline-secondary" href="/employee/products">Close</a>
        </div>
        <form method="post" action="/employee/products/{{.ID}}">
          {{$.CSRFField}}
          <div class="row g-3 align-items-end">
            <div class="col-md-6">
              <label class="form-label" for="edit-name">Name</label>
              <input class="form-control" id="edit-name" name="name" value="{{.Name}}" maxlength="200" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="edit-category">Category</label>
              <select class="form-select" id="edit-category" name="category_id">
                <option value="">No category</option>
                {{range $.Categories}}<option value="{{.ID}}"{{if and $product.Category (eq .ID $product.Category.ID)}} selected{{end}}>{{.Name}}</option>{{end}}
              </select>
            </div>
            <div class="col-12">
              <label class="form-label" for="edit-description">Description</label>
              <textarea class="form-control" id="edit-description" name="description" rows="3" maxlength="5000">{{.Description}}</textarea>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="edit-price">Price</label>
              <input class="form-control" id="edit-price" name="price" value="{{priceInput .PriceCents}}" required>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="edit-stock">Stock</label>
              <input class="form-control" id="edit-stock" type="number" min="0" name="stock" value="{{.Stock}}" required>
            </div>
            <div class="col-md-6"><button type="submit" class="btn btn-primary">Save changes</button></div>
          </div>
        </form>

        <hr class="my-4">
        <h3 class="h5 mb-3">Product images</h3>
        {{if .Images}}
        <div class="d-flex flex-wrap gap-3 mb-3">
          {{range .Images}}
          <div class="image-tile {{if eq .Filename $product.ImageFilename}}image-tile-cover{{end}}">
            <img src="/media/products/{{.Filename}}" alt="{{if eq .Filename $product.ImageFilename}}Cover image for {{end}}{{$product.Name}}" loading="lazy">
            <div class="image-actions mt-2">
              {{if eq .Filename $product.ImageFilename}}
              <span class="badge rounded-pill text-bg-dark">Cover</span>
              {{else}}
              <form method="post" action="/employee/products/{{$product.ID}}/images/{{.ID}}/cover">{{$.CSRFField}}<button type="submit" class="btn btn-sm btn-outline-primary w-100">Set cover</button></form>
              {{end}}
              <form method="post" action="/employee/products/{{$product.ID}}/images/{{.ID}}/delete">{{$.CSRFField}}<button type="submit" class="btn btn-sm btn-outline-danger w-100">Delete</button></form>
            </div>
          </div>
          {{end}}
        </div>
        {{else}}<p class="text-muted small">This product has no images.</p>{{end}}
        {{if lt (len .Images) $.ImageLimit}}
        <form method="post" action="/employee/products/{{.ID}}/images" enctype="multipart/form-data" class="row g-2 align-items-end">
          {{$.CSRFField}}
          <div class="col-md-8"><input class="form-control" type="file" name="images" accept=".jpg,.jpeg,.png,image/jpeg,image/png" multiple required aria-label="Images for {{.Name}}"><div class="form-text">{{len .Images}} / {{$.ImageLimit}} images</div></div>
          <div class="col-md-4"><button type="submit" class="btn btn-outline-secondary">Add images</button></div>
        </form>
        {{else}}<small class="text-muted">Image limit reached ({{$.ImageLimit}} / {{$.ImageLimit}}).</small>{{end}}
      </div>
    </section>
    {{end}}

    <section class="card panel-card">
      <div class="card-body p-4">
        <form method="get" action="/employee/products" class="row g-3 align-items-end mb-4">
          <div class="col-md-5">
            <label class="form-label" for="product-search">Product</label>
            <input class="form-control" id="product-search" name="q" value="{{.Search}}" maxlength="100" placeholder="Search by product name">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="product-category">Category</label>
            <select class="form-select" id="product-category" name="category_id">
              <option value="">All categories</option>
              {{range .Categories}}<option value="{{.ID}}"{{if eq .ID $.SelectedCategoryID}} selected{{end}}>{{.Name}}</option>{{end}}
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label" for="product-availability">Status</label>
            <select class="form-select" id="product-availability" name="availability">
              <option value="all"{{if eq .SelectedAvailability "all"}} selected{{end}}>All</option>
              <option value="active"{{if eq .SelectedAvailability "active"}} selected{{end}}>Active</option>
              <option value="inactive"{{if eq .SelectedAvailability "inactive"}} selected{{end}}>Inactive</option>
            </select>
          </div>
          <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit">Filter</button>
            {{if or .Search .SelectedCategoryID (ne .SelectedAvailability "all")}}<a class="btn btn-outline-secondary" href="/employee/products">Reset</a>{{end}}
          </div>
        </form>

        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Image</th><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
              {{range .Products}}
              <tr>
                <td>{{if .ImageFilename}}<img class="product-thumbnail" src="/media/products/{{.ImageFilename}}" alt="{{.Name}}" loading="lazy">{{else}}<span class="product-thumbnail d-inline-flex align-items-center justify-content-center text-primary fw-bold">{{initials .Name}}</span>{{end}}</td>
                <td><strong>{{.Name}}</strong><small class="text-muted d-block">#{{.ID}}</small></td>
                <td>{{if .Category}}{{.Category.Name}}{{else}}<span class="text-muted">—</span>{{end}}</td>
                <td>{{money .PriceCents}}</td>
                <td>{{.Stock}}</td>
                <td>{{if .Active}}<span class="badge bg-success-subtle text-success">Active</span>{{else}}<span class="badge bg-secondary-subtle text-secondary">Inactive</span>{{end}}</td>
                <td class="text-end text-nowrap">
                  <a class="btn btn-sm btn-outline-secondary" href="/products/{{.ID}}">View</a>
                  <a class="btn btn-sm btn-outline-primary" href="/employee/products?edit={{.ID}}#edit-product">Edit</a>
                  {{if .Active}}<form method="post" action="/employee/products/{{.ID}}/deactivate" class="d-inline">{{$.CSRFField}}<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button></form>{{end}}
                </td>
              </tr>
              {{else}}
              <tr><td colspan="7" class="text-muted text-center py-4">No products match these filters.</td></tr>
              {{end}}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
