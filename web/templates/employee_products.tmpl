{{define "employee_products.tmpl"}}<!doctype html><html><body><h1>Ürün yönetimi</h1><form method="post" action="/employee/products">{{.CSRFField}}<input name="name" placeholder="Ad" required><input name="description" placeholder="Açıklama"><input name="price" placeholder="19.99" required><input name="stock" type="number" min="0" value="0" required><select name="category_id"><option value="">Kategori yok</option>{{range .Categories}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><button type="submit">Ürün ekle</button></form><table><tr><th>Ad</th><th>Fiyat</th><th>Stok</th><th>Aktif</th></tr>{{range .Products}}<tr><td>{{.Name}}</td><td>{{money .PriceCents}}</td><td><form method="post" action="/employee/products/{{.ID}}/stock">{{$.CSRFField}}<input name="stock" type="number" min="0" value="{{.Stock}}"><button type="submit">Güncelle</button></form></td><td>{{.Active}}</td></tr>{{end}}</table></body></html>{{end}}
