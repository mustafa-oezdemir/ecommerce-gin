{{define "employee_products.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Product Management | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .panel-card { border: 0; border-radius: 1.2rem; box-shadow: 0 12px 28px rgba(15,23,42,0.08); }
    .product-thumbnail { width: 64px; height: 64px; border-radius: .9rem; object-fit: cover; background: #eef2ff; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/employee">Employee Dashboard</a>
      <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/employee/products">Products</a>
        <a class="btn btn-outline-light btn-sm" href="/employee/orders">Orders</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="card panel-card h-100">
          <div class="card-body p-4">
            <h1 class="h4 mb-3">New Product</h1>
            <form method="post" action="/employee/products" enctype="multipart/form-data">
              {{.CSRFField}}
              <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" name="name" placeholder="Name" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Description</label>
                <input class="form-control" name="description" placeholder="Description">
              </div>
              <div class="row g-2">
                <div class="col-6">
                  <label class="form-label">Price</label>
                  <input class="form-control" name="price" placeholder="19.99" required>
                </div>
                <div class="col-6">
                  <label class="form-label">Stock</label>
                  <input class="form-control" type="number" min="0" name="stock" value="0" required>
                </div>
              </div>
              <div class="mt-3">
                <label class="form-label">Category</label>
                <select class="form-select" name="category_id">
                  <option value="">No category</option>
                  {{range .Categories}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
                </select>
              </div>
              <div class="mt-3">
                <label class="form-label" for="new-product-image">Product image</label>
                <input class="form-control" id="new-product-image" type="file" name="image" accept=".jpg,.jpeg,.png,image/jpeg,image/png">
                <div class="form-text">JPEG or PNG, up to {{.ImageMaxMB}} MB. Every upload is virus-scanned and sanitized.</div>
              </div>
              <button type="submit" class="btn btn-primary mt-3">Add Product</button>
            </form>
          </div>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="card panel-card">
          <div class="card-body p-4">
            <h2 class="h4 mb-3">Product Management</h2>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead>
                  <tr><th>Image</th><th>Name</th><th>Price</th><th>Stock</th><th>Active</th></tr>
                </thead>
                <tbody>
                  {{range .Products}}
                  <tr>
                    <td>
                      {{if .ImageFilename}}<img class="product-thumbnail d-block mb-2" src="/media/products/{{.ImageFilename}}" alt="{{.Name}}" loading="lazy">{{else}}<div class="product-thumbnail d-flex align-items-center justify-content-center text-primary fw-bold mb-2">{{if .Category}}{{initials .Category.Name}}{{else}}N{{end}}</div>{{end}}
                      <form method="post" action="/employee/products/{{.ID}}/image" enctype="multipart/form-data" class="d-flex gap-1">
                        {{$.CSRFField}}
                        <input class="form-control form-control-sm" type="file" name="image" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required aria-label="Image for {{.Name}}">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Upload</button>
                      </form>
                    </td>
                    <td>{{.Name}}</td>
                    <td>{{money .PriceCents}}</td>
                    <td>
                      <form method="post" action="/employee/products/{{.ID}}/stock" class="d-flex gap-2 align-items-center">
                        {{$.CSRFField}}
                        <input class="form-control" name="stock" type="number" min="0" value="{{.Stock}}" style="max-width: 110px;">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                      </form>
                    </td>
                    <td><span class="badge bg-success-subtle text-success">{{.Active}}</span></td>
                  </tr>
                  {{else}}
                  <tr><td colspan="5" class="text-muted">No products found.</td></tr>
                  {{end}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
{{end}}
