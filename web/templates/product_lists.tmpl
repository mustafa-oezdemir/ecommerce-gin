{{define "product_lists.tmpl"}}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Listelerim | NordShop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .list-card { border: 0; border-radius: 1.25rem; box-shadow: 0 12px 30px rgba(15,23,42,0.08); }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">NordShop</a>
      <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/account">Hesabım</a>
        <a class="btn btn-outline-light btn-sm" href="/account/purchases">Satın aldıklarım</a>
        <a class="btn btn-outline-light btn-sm" href="/cart">Sepet</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Kişisel koleksiyonlar</span>
        <h1 class="h2 mt-3 mb-0">Listelerim</h1>
      </div>
      <a href="/account" class="btn btn-outline-secondary">Hesaba dön</a>
    </div>

    <div class="card list-card mb-4">
      <div class="card-body p-4">
        <h2 class="h5 mb-3">Yeni liste oluştur</h2>
        <form method="post" action="/account/lists" class="row g-2">
          {{.CSRFField}}
          <div class="col-md-8">
            <input class="form-control" name="name" placeholder="Örn. Sonra alacaklarım" minlength="2" maxlength="100" required>
          </div>
          <div class="col-md-4 d-grid">
            <button class="btn btn-primary" type="submit">Liste oluştur</button>
          </div>
        </form>
      </div>
    </div>

    {{if .Lists}}
    <div class="row g-3">
      {{range .Lists}}
      <div class="col-md-6 col-xl-4">
        <div class="card list-card h-100">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-start gap-3">
              <div>
                <h2 class="h5 mb-1">{{.Name}}</h2>
                <p class="text-muted small mb-3">{{len .Items}} ürün</p>
              </div>
              <span class="badge rounded-pill bg-light text-dark">{{len .Items}}</span>
            </div>
            <a class="btn btn-outline-primary mt-auto" href="/account/lists/{{.ID}}">Listeyi aç</a>
          </div>
        </div>
      </div>
      {{end}}
    </div>
    {{else}}
    <div class="alert alert-light border text-center py-5">
      <h2 class="h4 mb-2">Henüz bir listeniz yok</h2>
      <p class="text-muted mb-0">Ürünleri düzenlemek için ilk listenizi oluşturun.</p>
    </div>
    {{end}}
  </main>
</body>
</html>
{{end}}
