{{define "admin_categories.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Categories | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .panel-card { border: 0; border-radius: 1.2rem; box-shadow: 0 12px 28px rgba(15,23,42,0.08); }
    .toggle-card > summary { cursor: pointer; list-style: none; }
    .toggle-card > summary::-webkit-details-marker { display: none; }
  </style>
</head>
<body>
  {{template "site-nav" .}}

  <main class="app-main container py-5">
    {{if .Success}}<div class="alert alert-success" role="status">{{.Success}}</div>{{end}}
    {{if .Error}}<div class="alert alert-danger" role="alert">{{.Error}}</div>{{end}}

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <h1 class="h3 mb-1">Categories</h1>
        <p class="text-muted mb-0">Manage product categories and descriptions.</p>
      </div>
      <span class="badge rounded-pill text-bg-light">{{len .Categories}} categories</span>
    </div>

    <details class="card panel-card toggle-card mb-4" id="new-category">
      <summary class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
        <span class="fw-semibold">New Category</span>
        <span class="btn btn-primary btn-sm">Add category</span>
      </summary>
      <div class="card-body border-top p-4">
        <form method="post" action="/admin/categories">
          {{.CSRFField}}
          <div class="row g-3 align-items-end">
            <div class="col-md-4">
              <label class="form-label" for="new-category-name">Name</label>
              <input class="form-control" id="new-category-name" name="name" minlength="2" maxlength="100" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="new-category-description">Description</label>
              <textarea class="form-control" id="new-category-description" name="description" rows="1" maxlength="5000"></textarea>
            </div>
            <div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary">Create</button></div>
          </div>
        </form>
      </div>
    </details>

    {{with .EditCategory}}
    <section class="card panel-card mb-4" id="edit-category">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
          <div><span class="text-muted small">Editing category</span><h2 class="h4 mb-0">{{.Name}}</h2></div>
          <a class="btn btn-sm btn-outline-secondary" href="/admin/categories">Close</a>
        </div>
        <form method="post" action="/admin/categories/{{.ID}}">
          {{$.CSRFField}}
          <div class="row g-3 align-items-end">
            <div class="col-md-4">
              <label class="form-label" for="edit-category-name">Name</label>
              <input class="form-control" id="edit-category-name" name="name" value="{{.Name}}" minlength="2" maxlength="100" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="edit-category-description">Description</label>
              <textarea class="form-control" id="edit-category-description" name="description" rows="2" maxlength="5000">{{.Description}}</textarea>
            </div>
            <div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary">Save changes</button></div>
          </div>
        </form>
      </div>
    </section>
    {{end}}

    <section class="card panel-card">
      <div class="card-body p-4">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>ID</th><th>Name</th><th>Description</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
              {{range .Categories}}
              <tr>
                <td>#{{.ID}}</td>
                <td class="fw-semibold">{{.Name}}</td>
                <td>{{if .Description}}{{.Description}}{{else}}<span class="text-muted">—</span>{{end}}</td>
                <td class="text-end text-nowrap">
                  <a class="btn btn-sm btn-outline-primary" href="/admin/categories?edit={{.ID}}#edit-category">Edit</a>
                  <form method="post" action="/admin/categories/{{.ID}}/delete" class="d-inline">
                    {{$.CSRFField}}
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </td>
              </tr>
              {{else}}
              <tr><td colspan="4" class="text-muted text-center py-4">No categories added yet.</td></tr>
              {{end}}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
