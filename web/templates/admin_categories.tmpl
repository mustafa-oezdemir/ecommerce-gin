{{define "admin_categories.tmpl"}}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kategoriler | NordShop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .panel-card { border: 0; border-radius: 1.2rem; box-shadow: 0 12px 28px rgba(15,23,42,0.08); }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/admin">Yönetici</a>
      <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/admin/users">Kullanıcılar</a>
        <a class="btn btn-outline-light btn-sm" href="/admin/orders">Siparişler</a>
        <a class="btn btn-outline-light btn-sm" href="/admin/categories">Kategoriler</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="card panel-card h-100">
          <div class="card-body p-4">
            <h1 class="h4 mb-3">Yeni kategori</h1>
            <form method="post" action="/admin/categories">
              {{.CSRFField}}
              <div class="mb-3">
                <label class="form-label">Ad</label>
                <input class="form-control" name="name" placeholder="Ad" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <input class="form-control" name="description" placeholder="Açıklama">
              </div>
              <button type="submit" class="btn btn-primary">Kategori ekle</button>
            </form>
          </div>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="card panel-card">
          <div class="card-body p-4">
            <h2 class="h4 mb-3">Kategoriler</h2>
            <div class="list-group list-group-flush">
              {{range .Categories}}
              <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                <div>
                  <div class="fw-semibold">{{.Name}}</div>
                  <small class="text-muted">{{.Description}}</small>
                </div>
                <form method="post" action="/admin/categories/{{.ID}}/delete">
                  {{$.CSRFField}}
                  <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
              </div>
              {{else}}
              <div class="text-muted">Henüz kategori eklenmemiş.</div>
              {{end}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
{{end}}
