{{define "addresses.tmpl"}}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Addresses | PehliOne</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/static/site.css" rel="stylesheet"></head>
<body>
{{template "site-nav" .}}
<main class="app-main container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4"><div><span class="badge text-bg-primary">My Account</span><h1 class="h2 mt-2">Addresses</h1></div><a class="btn btn-outline-secondary" href="/checkout">Back to Checkout</a></div>
  <section class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><h2 class="h5">Add Address</h2>
    <form method="post" action="/account/addresses" class="row g-3">
      {{.CSRFField}}
      <div class="col-md-6"><label class="form-label">First name<input class="form-control" name="first_name" maxlength="100" required></label></div>
      <div class="col-md-6"><label class="form-label">Last name<input class="form-control" name="last_name" maxlength="100" required></label></div>
      <div class="col-md-6"><label class="form-label">Company (optional)<input class="form-control" name="company" maxlength="150"></label></div>
      <div class="col-md-6"><label class="form-label">Phone<input class="form-control" name="phone" maxlength="32" required></label></div>
      <div class="col-md-8"><label class="form-label">Street<input class="form-control" name="street" maxlength="150" required></label></div>
      <div class="col-md-4"><label class="form-label">House number<input class="form-control" name="house_number" maxlength="30" required></label></div>
      <div class="col-12"><label class="form-label">Address line 2 (optional)<input class="form-control" name="address_line_2" maxlength="150"></label></div>
      <div class="col-md-4"><label class="form-label">Postal code<input class="form-control" name="postal_code" maxlength="20" required></label></div>
      <div class="col-md-4"><label class="form-label">City<input class="form-control" name="city" maxlength="100" required></label></div>
      <div class="col-md-4"><label class="form-label">State / Region<input class="form-control" name="state" maxlength="100"></label></div>
      <div class="col-md-4"><label class="form-label">Country code<input class="form-control text-uppercase" name="country_code" maxlength="2" minlength="2" placeholder="DE" required></label></div>
      <div class="col-md-8 d-flex align-items-end"><label class="form-check mb-2"><input class="form-check-input" type="checkbox" name="is_default" value="true"> Default address</label></div>
      <div><button class="btn btn-primary" type="submit">Save Address</button></div>
    </form>
  </div></section>
  <div class="row g-3">{{range .Addresses}}<div class="col-lg-6"><section class="card border-0 shadow-sm h-100"><div class="card-body p-4">
    <div class="d-flex justify-content-between"><h2 class="h5">{{.FirstName}} {{.LastName}}</h2>{{if .IsDefault}}<span class="badge text-bg-success">Default</span>{{end}}</div>
    <p class="text-muted">{{.Street}} {{.HouseNumber}}<br>{{if .AddressLine2}}{{.AddressLine2}}<br>{{end}}{{.PostalCode}} {{.City}} {{.State}}<br>{{.CountryCode}} · {{.Phone}}</p>
    <details><summary class="btn btn-sm btn-outline-primary">Edit</summary>
      <form method="post" action="/account/addresses/{{.ID}}" class="row g-2 mt-2">
        {{$.CSRFField}}
        <div class="col-6"><input class="form-control" name="first_name" value="{{.FirstName}}" required></div><div class="col-6"><input class="form-control" name="last_name" value="{{.LastName}}" required></div>
        <div class="col-8"><input class="form-control" name="street" value="{{.Street}}" required></div><div class="col-4"><input class="form-control" name="house_number" value="{{.HouseNumber}}" required></div>
        <input type="hidden" name="company" value="{{.Company}}"><input type="hidden" name="address_line_2" value="{{.AddressLine2}}"><input type="hidden" name="state" value="{{.State}}">
        <div class="col-4"><input class="form-control" name="postal_code" value="{{.PostalCode}}" required></div><div class="col-4"><input class="form-control" name="city" value="{{.City}}" required></div><div class="col-4"><input class="form-control" name="country_code" value="{{.CountryCode}}" required></div>
        <div class="col-8"><input class="form-control" name="phone" value="{{.Phone}}" required></div><div class="col-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="is_default" value="true" {{if .IsDefault}}checked{{end}}> Default</label></div>
        <div><button class="btn btn-primary btn-sm" type="submit">Update</button></div>
      </form>
    </details>
    <form method="post" action="/account/addresses/{{.ID}}/delete" class="mt-2">{{$.CSRFField}}<button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form>
  </div></section></div>{{else}}<div class="col-12"><div class="alert alert-light border">No saved addresses yet.</div></div>{{end}}</div>
</main>
{{template "site-footer" .}}
</body></html>
{{end}}
