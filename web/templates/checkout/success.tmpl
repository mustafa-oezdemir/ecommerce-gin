{{define "checkout/success"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Order Complete | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
  <script src="/static/site-ui.js" defer></script>
  <script src="/static/checkout.js" defer></script>
  <style>
    body { background: linear-gradient(180deg, #f0fdf4 0%, #f8fafc 100%); }
    .success-card { border: 0; border-radius: 1.5rem; box-shadow: 0 18px 40px rgba(22, 163, 74, 0.12); }
  </style>
</head>
<body>
  {{template "site-nav" .}}
  <main class="app-main container py-5 d-flex align-items-center">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card success-card border-success-subtle">
          <div class="card-body text-center p-5">
            <div class="mb-4">
              <div class="rounded-circle {{if .PaymentPending}}bg-warning-subtle text-warning-emphasis{{else if .PaymentFailed}}bg-danger-subtle text-danger{{else}}bg-success-subtle text-success{{end}} mx-auto d-flex align-items-center justify-content-center" style="width: 88px; height: 88px; font-size: 2.3rem;">{{if .PaymentPending}}…{{else if .PaymentFailed}}×{{else}}✓{{end}}</div>
            </div>
            {{if .PaymentPending}}
            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-2">Payment confirmation pending</span>
            <h1 class="h2 mt-3 mb-3">Zahlung wird bestätigt…</h1>
            <p class="text-muted" data-payment-poll data-order-id="{{.Order.ID}}">We are waiting for the signed confirmation from PehliOne Bank. You may safely keep this page open.</p>
            {{else if .PaymentFailed}}
            <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">Payment not completed</span>
            <h1 class="h2 mt-3 mb-3">Payment failed or was cancelled</h1>
            <p class="text-muted">No successful bank confirmation was received. Reserved stock has been released.</p>
            {{else}}
            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">Order Received</span>
            <h1 class="h2 mt-3 mb-3">Thank you!</h1>
            {{end}}
            <p class="text-muted mb-2">Your order 
            <strong>{{if .Order.OrderNumber}}{{.Order.OrderNumber}}{{else}}#{{.Order.ID}}{{end}}</strong> has been successfully placed.</p>
            {{if .Order.Payment.ID}}
            <p class="text-muted mb-2">Payment: 
            <strong>{{.Order.Payment.Status}}</strong> via {{.Order.Payment.Method}}</p>{{end}}
            {{range .Order.Addresses}}{{if eq .Type "shipping"}}
            <p class="text-muted mb-4">Shipping to: {{.FirstName}} {{.LastName}}, {{.Street}} {{.HouseNumber}}, {{.PostalCode}} {{.City}}
            </p>{{end}}{{end}}
            <div class="fs-5 fw-bold mb-4">Total: {{money .Order.TotalCents}}</div>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
              <a href="/account/orders/{{.Order.ID}}" class="btn btn-primary">View Order</a>
              <a href="/" class="btn btn-outline-secondary">Continue Shopping</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
