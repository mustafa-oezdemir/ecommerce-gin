{{define "product_list_detail.tmpl"}}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.List.Name}} | NordShop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .list-card { border: 0; border-radius: 1.25rem; box-shadow: 0 12px 30px rgba(15,23,42,0.08); }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">NordShop</a>
      <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/account">Hesabım</a>
        <a class="btn btn-outline-light btn-sm" href="/account/lists">Listelerim</a>
        <a class="btn btn-outline-light btn-sm" href="/cart">Sepet</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Ürün listesi</span>
        <h1 class="h2 mt-3 mb-0">{{.List.Name}}</h1>
      </div>
      <div class="d-flex gap-2">
        <a href="/account/lists" class="btn btn-outline-secondary">Tüm listeler</a>
        <form method="post" action="/account/lists/{{.List.ID}}/delete">
          {{.CSRFField}}
          <button class="btn btn-outline-danger" type="submit">Listeyi sil</button>
        </form>
      </div>
    </div>

    <div class="card list-card mb-4">
      <div class="card-body p-4">
        <h2 class="h5 mb-3">Ürün ekle</h2>
        {{if .Products}}
        <form method="post" action="/account/lists/{{.List.ID}}/products" class="row g-2">
          {{.CSRFField}}
          <div class="col-md-8">
            <select class="form-select" name="product_id" required>
              <option value="" selected disabled>Bir ürün seçin</option>
              {{range .Products}}<option value="{{.ID}}">{{.Name}} — {{money .PriceCents}}</option>{{end}}
            </select>
          </div>
          <div class="col-md-4 d-grid"><button class="btn btn-primary" type="submit">Listeye ekle</button></div>
        </form>
        {{else}}
        <p class="text-muted mb-0">Eklenebilecek aktif ürün bulunmuyor.</p>
        {{end}}
      </div>
    </div>

    <div class="card list-card">
      <div class="card-body p-4">
        <h2 class="h5 mb-3">Listedeki ürünler</h2>
        {{if .List.Items}}
        <div class="list-group list-group-flush">
          {{range .List.Items}}
          <div class="list-group-item px-0 d-flex justify-content-between align-items-center gap-3">
            <div>
              <a class="fw-semibold text-decoration-none" href="/products/{{.ProductID}}">{{.Product.Name}}</a>
              <div class="small text-muted">{{money .Product.PriceCents}}{{if .Product.Category}} · {{.Product.Category.Name}}{{end}}</div>
            </div>
            <form method="post" action="/account/lists/{{$.List.ID}}/products/{{.ProductID}}/remove">
              {{$.CSRFField}}
              <button class="btn btn-sm btn-outline-danger" type="submit">Çıkar</button>
            </form>
          </div>
          {{end}}
        </div>
        {{else}}
        <p class="text-muted mb-0">Bu liste henüz boş.</p>
        {{end}}
      </div>
    </div>
  </main>
</body>
</html>
{{end}}
