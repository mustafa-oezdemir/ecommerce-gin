{{define "product_detail.tmpl"}}<!doctype html><html><body><h1>{{.Product.Name}}</h1><p>{{.Product.Description}}</p><p>{{money .Product.PriceCents}}</p><p>Stok: {{.Product.Stock}}</p><form method="post" action="/cart/add/{{.Product.ID}}">{{.CSRFField}}<input type="number" name="quantity" value="1" min="1" max="100"><button type="submit">Sepete ekle</button></form><a href="/">Geri</a></body></html>{{end}}
