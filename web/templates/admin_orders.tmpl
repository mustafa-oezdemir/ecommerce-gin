{{define "admin_orders.tmpl"}}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Siparişler | NordShop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .panel-card { border: 0; border-radius: 1.2rem; box-shadow: 0 12px 28px rgba(15,23,42,0.08); }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/admin">Yönetici</a>
      <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/admin/users">Kullanıcılar</a>
        <a class="btn btn-outline-light btn-sm" href="/admin/orders">Siparişler</a>
        <a class="btn btn-outline-light btn-sm" href="/admin/categories">Kategoriler</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="card panel-card">
      <div class="card-body p-4">
        <h1 class="h4 mb-3">Tüm siparişler</h1>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr><th>ID</th><th>Kullanıcı</th><th>Durum</th><th>Toplam</th></tr>
            </thead>
            <tbody>
              {{range .Orders}}
              <tr>
                <td>#{{.ID}}</td>
                <td>{{.User.Email}}</td>
                <td><span class="badge bg-light text-dark text-capitalize">{{.Status}}</span></td>
                <td>{{money .TotalCents}}</td>
              </tr>
              {{else}}
              <tr><td colspan="4" class="text-muted">Sipariş bulunamadı.</td></tr>
              {{end}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
{{end}}}
