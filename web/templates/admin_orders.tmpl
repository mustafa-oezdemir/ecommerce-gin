{{define "admin_orders.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Orders | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .panel-card { border: 0; border-radius: 1.2rem; box-shadow: 0 12px 28px rgba(15,23,42,0.08); }
  </style>
</head>
<body>
  {{template "site-nav" .}}

  <main class="app-main container py-5">
    <div class="card panel-card">
      <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
          <div>
            <h1 class="h4 mb-1">{{if .PendingFilter}}Pending Orders{{else}}All Orders{{end}}</h1>
            <p class="text-muted small mb-0">Filter by user or status, then sort the results.</p>
          </div>
          <span class="badge rounded-pill text-bg-light">{{if .TotalOrders}}{{len .Orders}} of {{.TotalOrders}} orders{{else}}{{len .Orders}} orders{{end}}</span>
        </div>
        {{if .PendingFilter}}<div class="d-flex flex-wrap align-items-center gap-2 mb-3" aria-label="Active filters"><span class="text-muted small">Filter:</span><a class="badge rounded-pill text-bg-warning text-decoration-none" href="/admin/orders" aria-label="Remove pending filter">Pending ×</a><a class="ms-auto small" href="{{.DashboardURL}}">← Back to Dashboard</a></div>{{end}}
        <form method="get" action="/admin/orders" class="row g-3 align-items-end mb-4">
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="order-user">User</label>
            <input class="form-control" id="order-user" name="user" value="{{.UserSearch}}" maxlength="100" placeholder="Name or email">
          </div>
          <div class="col-md-6 col-lg-3">
            <label class="form-label" for="order-status">Status</label>
            <select class="form-select text-capitalize" id="order-status" name="status">
              <option value="">All statuses</option>
              {{range .Statuses}}
              <option value="{{.}}" {{if eq (printf "%s" .) $.SelectedStatus}}selected{{end}}>{{.}}</option>
              {{end}}
            </select>
          </div>
          <div class="col-md-6 col-lg-3">
            <label class="form-label" for="order-sort">Sort by</label>
            <select class="form-select" id="order-sort" name="sort">
              <option value="id_desc" {{if eq .SelectedSort "id_desc"}}selected{{end}}>ID — newest first</option>
              <option value="id_asc" {{if eq .SelectedSort "id_asc"}}selected{{end}}>ID — oldest first</option>
              <option value="user_asc" {{if eq .SelectedSort "user_asc"}}selected{{end}}>User — A to Z</option>
              <option value="user_desc" {{if eq .SelectedSort "user_desc"}}selected{{end}}>User — Z to A</option>
              <option value="total_desc" {{if eq .SelectedSort "total_desc"}}selected{{end}}>Total — highest first</option>
              <option value="total_asc" {{if eq .SelectedSort "total_asc"}}selected{{end}}>Total — lowest first</option>
            </select>
          </div>
          <div class="col-md-6 col-lg-2 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit">Apply filters</button>
            {{if or .UserSearch .SelectedStatus (ne .SelectedSort "id_desc")}}<a class="btn btn-outline-secondary" href="/admin/orders">Reset</a>{{end}}
          </div>
        </form>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr><th>ID</th><th>User</th><th>Status</th><th>Total</th></tr>
            </thead>
            <tbody>
              {{range .Orders}}
              <tr>
                <td>#{{.ID}}</td>
                <td>{{if .User.Name}}<span class="d-block">{{.User.Name}}</span>{{end}}<small class="text-muted">{{.User.Email}}</small></td>
                <td><span class="badge bg-light text-dark text-capitalize">{{.Status}}</span></td>
                <td>{{money .TotalCents}}</td>
              </tr>
              {{else}}
              <tr><td colspan="4" class="text-muted text-center py-4">{{if .PendingFilter}}No pending orders.{{else}}No orders found.{{end}}</td></tr>
              {{end}}
            </tbody>
          </table>
        </div>
        {{if .TotalPages}}{{if gt .TotalPages 1}}
        <nav class="mt-4" aria-label="Orders pagination">
          <ul class="pagination justify-content-center mb-0">
            <li class="page-item{{if eq .Page 1}} disabled{{end}}">
              {{if gt .Page 1}}<a class="page-link" href="?{{.PaginationQuery}}&page={{sub .Page 1}}" aria-label="Previous page">Previous</a>{{else}}<span class="page-link">Previous</span>{{end}}
            </li>
            {{range .PageNumbers}}
            <li class="page-item{{if eq . $.Page}} active{{end}}">
              <a class="page-link" href="?{{$.PaginationQuery}}&page={{.}}"{{if eq . $.Page}} aria-current="page"{{end}}>{{.}}</a>
            </li>
            {{end}}
            <li class="page-item{{if eq .Page .TotalPages}} disabled{{end}}">
              {{if lt .Page .TotalPages}}<a class="page-link" href="?{{.PaginationQuery}}&page={{add .Page 1}}" aria-label="Next page">Next</a>{{else}}<span class="page-link">Next</span>{{end}}
            </li>
          </ul>
          <p class="text-muted small text-center mt-2 mb-0">Page {{.Page}} of {{.TotalPages}} · 20 orders per page</p>
        </nav>
        {{end}}{{end}}
      </div>
    </div>
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
