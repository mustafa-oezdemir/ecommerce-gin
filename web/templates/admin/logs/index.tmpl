{{define "admin/logs/index"}}{{template "layouts/admin/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/admin/dashboard" "HomeLabel" "Dashboard" "Current" "Application Logs")}}{{template "partials/page-header" (dict "Title" "Application Logs" "Description" "Review structured application events. Times are displayed in UTC.")}}
{{if .AutoRefresh}}<div data-auto-refresh="10" hidden></div>{{end}}
<section class="row g-3 mb-4" aria-label="Log summary"><div class="col-6 col-lg"><div class="content-card h-100"><div class="text-muted small">Scanned</div><div class="display-6 fw-bold">{{.Snapshot.Scanned}}</div></div></div><div class="col-6 col-lg"><div class="content-card h-100"><div class="text-muted small">Info</div><div class="display-6 fw-bold text-primary">{{.Snapshot.InfoCount}}</div></div></div><div class="col-6 col-lg"><div class="content-card h-100"><div class="text-muted small">Warnings</div><div class="display-6 fw-bold text-warning">{{.Snapshot.WarnCount}}</div></div></div><div class="col-6 col-lg"><div class="content-card h-100"><div class="text-muted small">Errors</div><div class="display-6 fw-bold text-danger">{{.Snapshot.ErrorCount}}</div></div></div><div class="col-12 col-lg"><div class="content-card h-100"><div class="text-muted small">Log file</div><div class="h3 mb-1">{{.Snapshot.FileSizeText}}</div><div class="small text-muted">Updated {{.Snapshot.LastModified}}</div></div></div></section>
<section class="table-toolbar"><form method="get" action="/admin/logs" class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label" for="log-level">Level</label><select class="form-select" id="log-level" name="level"><option value="all" {{if eq .Level "all"}}selected{{end}}>All levels</option><option value="debug" {{if eq .Level "debug"}}selected{{end}}>Debug</option><option value="info" {{if eq .Level "info"}}selected{{end}}>Info</option><option value="warn" {{if eq .Level "warn"}}selected{{end}}>Warning</option><option value="error" {{if eq .Level "error"}}selected{{end}}>Error</option></select></div><div class="col-md-5"><label class="form-label" for="log-search">Search</label><input class="form-control" id="log-search" name="q" value="{{.Search}}" maxlength="100" placeholder="Message, route, request ID…"></div><div class="col-md-2"><label class="form-label" for="log-limit">Entries</label><select class="form-select" id="log-limit" name="limit"><option value="50" {{if eq .Limit 50}}selected{{end}}>50</option><option value="100" {{if eq .Limit 100}}selected{{end}}>100</option><option value="200" {{if eq .Limit 200}}selected{{end}}>200</option><option value="500" {{if eq .Limit 500}}selected{{end}}>500</option></select></div>{{if .AutoRefresh}}<input type="hidden" name="refresh" value="10">{{end}}<div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Apply filters</button></div></form><div class="mt-3">{{if .AutoRefresh}}<a class="btn btn-sm btn-outline-secondary" href="/admin/logs?level={{.Level}}&amp;limit={{.Limit}}&amp;q={{.Search}}">Pause auto-refresh</a>{{else}}<a class="btn btn-sm btn-outline-primary" href="/admin/logs?level={{.Level}}&amp;limit={{.Limit}}&amp;q={{.Search}}&amp;refresh=10">Auto-refresh every 10s</a>{{end}}</div></section>
{{if .Snapshot.Partial}}<div class="alert alert-info">For performance, this view scans only the newest 2 MB of the log file.</div>{{end}}
<section class="d-grid gap-3" aria-live="polite">{{range .Snapshot.Entries}}<article class="content-card"><div class="d-flex flex-wrap justify-content-between gap-2 mb-2"><span class="status-badge status-{{.LevelClass}}">{{.Level}}</span><time class="small text-muted">{{.Time}}</time></div><div class="fw-semibold text-break">{{.Message}}</div>{{if .Attributes}}<div class="mt-2">{{range .Attributes}}<span class="badge text-bg-light me-1"><strong>{{.Name}}</strong> {{.Value}}</span>{{end}}</div>{{end}}</article>{{else}}{{template "partials/empty-state" (dict "Title" "No matching log entries" "Description" "Try a different level, search term, or entry limit.")}}{{end}}</section>
{{template "layouts/admin/end" .}}{{end}}
