{{define "admin/dashboard/index"}}{{template "layouts/admin/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/admin/dashboard" "HomeLabel" "Dashboard" "Current" "Overview")}}{{template "partials/page-header" (dict "Title" "Admin Dashboard" "Description" "Commerce, customer and catalog overview.")}}<div class="row g-4">{{template "dashboard/stat" (dict "Label" "Customers" "Value" .Customers)}}{{template "dashboard/stat" (dict "Label" "Employees" "Value" .Employees)}}{{template "dashboard/stat" (dict "Label" "Products" "Value" .Products)}}{{template "dashboard/stat" (dict "Label" "Revenue" "Value" (money .RevenueCents))}}<div class="col-md-6 col-xl-3"><a class="card stat-card stat-card-link h-100" href="/admin/orders?status=pending" aria-label="View {{.PendingOrders}} pending orders"><div class="card-body"><span class="text-muted small">Pending Orders</span><div class="display-6 fw-bold mt-2">{{.PendingOrders}}</div></div></a></div><div class="col-md-6 col-xl-3"><a class="card stat-card stat-card-link h-100" href="/employee/products?stock_status=low" aria-label="View {{.LowStock}} low-stock products"><div class="card-body"><span class="text-muted small">Low Stock</span><div class="display-6 fw-bold mt-2">{{.LowStock}}</div></div></a></div>{{template "dashboard/stat" (dict "Label" "Total Orders" "Value" .TotalOrders)}}</div>{{template "layouts/admin/end" .}}{{end}}
{{define "dashboard/stat"}}<div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">{{.Label}}</span><div class="display-6 fw-bold mt-2">{{.Value}}</div></div></div></div>{{end}}
