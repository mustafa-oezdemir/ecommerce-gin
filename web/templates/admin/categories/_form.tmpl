{{define "admin/categories/form"}}<form method="post" action="{{.Action}}" class="row g-3">{{.CSRF}}<div class="col-12"><label class="form-label" for="category-name">Name</label><input class="form-control" id="category-name" name="name" value="{{.Category.Name}}" minlength="2" maxlength="100" required></div><div class="col-12"><label class="form-label" for="category-description">Description</label><textarea class="form-control" id="category-description" name="description" rows="5" maxlength="5000">{{.Category.Description}}</textarea></div><div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="/admin/categories">Cancel</a><button class="btn btn-primary" type="submit">{{if .Editing}}Save changes{{else}}Create category{{end}}</button></div></form>{{end}}
