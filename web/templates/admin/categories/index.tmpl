{{define "admin/categories/index"}}{{template "layouts/admin/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/admin/dashboard" "HomeLabel" "Dashboard" "Current" "Categories")}}{{template "partials/flash-messages" .}}{{template "partials/page-header" (dict "Title" "Categories" "Description" "Organize the product catalog." "ActionURL" "/admin/categories/new" "ActionLabel" "+ Add Category")}}<section class="table-toolbar"><form method="get" action="/admin/categories" class="row g-3 align-items-end"><div class="col-md-10"><label class="form-label" for="category-search">Search categories</label><input class="form-control" id="category-search" name="q" value="{{.Search}}" maxlength="100" placeholder="Category name"></div><div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Search</button></div></form></section><section class="content-card"><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>Category</th><th>Description</th><th class="text-end">Actions</th></tr></thead><tbody>{{$root := .}}{{range .Categories}}<tr><td><strong>{{.Name}}</strong><div class="small text-muted">#{{.ID}}</div></td><td>{{if .Description}}{{.Description}}{{else}}<span class="text-muted">No description</span>{{end}}</td><td class="text-end">{{template "partials/action-buttons" (dict "ViewURL" (printf "/admin/categories/%d" .ID) "EditURL" (printf "/admin/categories/%d/edit" .ID) "DeleteDialog" (printf "delete-category-%d" .ID))}}{{template "partials/confirm-delete" (dict "ID" (printf "delete-category-%d" .ID) "Name" .Name "Message" "Products remain available without this category." "Action" (printf "/admin/categories/%d/delete" .ID) "CSRF" $root.CSRFField)}}</td></tr>{{else}}<tr><td colspan="3">{{template "partials/empty-state" (dict "Title" "No categories found." "Description" "Create the first category or change your search." "ActionURL" "/admin/categories/new" "ActionLabel" "Add Category")}}</td></tr>{{end}}</tbody></table></div></section>{{template "layouts/admin/end" .}}{{end}}
