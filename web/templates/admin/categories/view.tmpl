{{define "admin/categories/view"}}{{template "layouts/admin/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/admin/dashboard" "HomeLabel" "Dashboard" "ParentURL" "/admin/categories" "ParentLabel" "Categories" "Current" .Category.Name)}}{{template "partials/page-header" (dict "Title" .Category.Name "Description" "Category details." "ActionURL" (printf "/admin/categories/%d/edit" .Category.ID) "ActionLabel" "Edit Category")}}<section class="content-card"><dl class="row mb-0"><dt class="col-sm-3">Category ID</dt><dd class="col-sm-9">#{{.Category.ID}}</dd><dt class="col-sm-3">Name</dt><dd class="col-sm-9">{{.Category.Name}}</dd><dt class="col-sm-3">Description</dt><dd class="col-sm-9 mb-0">{{if .Category.Description}}{{.Category.Description}}{{else}}<span class="text-muted">No description.</span>{{end}}</dd></dl></section>{{template "layouts/admin/end" .}}{{end}}
