{{define "admin/users/form"}}<form method="post" action="{{.Action}}" class="row g-3">{{.CSRF}}<div class="col-md-6"><label class="form-label" for="user-name">Name</label><input class="form-control" id="user-name" name="name" value="{{.User.Name}}" minlength="2" maxlength="100" required></div><div class="col-md-6"><label class="form-label" for="user-email">Email</label><input class="form-control" id="user-email" type="email" name="email" value="{{.User.Email}}" maxlength="254" required></div><div class="col-md-6"><label class="form-label" for="user-role-form">Role</label><select class="form-select" id="user-role-form" name="role" required><option value="customer"{{if eq .User.Role "customer"}} selected{{end}}>Customer</option><option value="employee"{{if eq .User.Role "employee"}} selected{{end}}>Employee</option>{{if .Editing}}<option value="admin"{{if eq .User.Role "admin"}} selected{{end}}>Administrator</option>{{end}}</select></div><div class="col-md-6"><label class="form-label" for="user-password">{{if .Editing}}New password (optional){{else}}Password{{end}}</label><input class="form-control" id="user-password" type="password" name="password" minlength="12" maxlength="72" autocomplete="new-password" {{if not .Editing}}required{{end}}></div><div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="/admin/users">Cancel</a><button class="btn btn-primary" type="submit">{{if .Editing}}Save changes{{else}}Create user{{end}}</button></div></form>{{end}}
