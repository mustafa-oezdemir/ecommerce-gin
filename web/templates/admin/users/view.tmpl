{{define "admin/users/view"}}{{template "layouts/admin/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/admin/dashboard" "HomeLabel" "Dashboard" "ParentURL" "/admin/users" "ParentLabel" "Users" "Current" .User.Name)}}{{template "partials/page-header" (dict "Title" .User.Name "Description" "Account details and permissions." "ActionURL" (printf "/admin/users/%d/edit" .User.ID) "ActionLabel" "Edit User")}}<section class="content-card"><dl class="row mb-0"><dt class="col-sm-3">User ID</dt><dd class="col-sm-9">#{{.User.ID}}</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">{{.User.Email}}</dd><dt class="col-sm-3">Role</dt><dd class="col-sm-9"><span class="status-badge status-active">{{statusLabel .User.Role}}</span></dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9 mb-0"><span class="status-badge status-active">Active</span></dd></dl></section>{{template "layouts/admin/end" .}}{{end}}
