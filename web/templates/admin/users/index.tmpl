{{define "admin/users/index"}}
{{template "layouts/admin/start" .}}
{{template "partials/breadcrumbs" (dict "HomeURL" "/admin/dashboard" "HomeLabel" "Dashboard" "Current" "Users")}}
{{template "partials/flash-messages" .}}
{{template "partials/page-header" (dict "Title" "Users" "Description" "Manage account details and permissions." "ActionURL" "/admin/users/new" "ActionLabel" "+ Add User")}}
<section class="table-toolbar"><form method="get" action="/admin/users" class="row g-3 align-items-end"><div class="col-md-7"><label class="form-label" for="user-search">Search users</label><input class="form-control" id="user-search" name="q" value="{{.Search}}" maxlength="100" placeholder="Name or email"></div><div class="col-md-3"><label class="form-label" for="user-role">Role</label><select class="form-select" id="user-role" name="role"><option value="all"{{if eq .SelectedRole "all"}} selected{{end}}>All roles</option><option value="admin"{{if eq .SelectedRole "admin"}} selected{{end}}>Administrator</option><option value="employee"{{if eq .SelectedRole "employee"}} selected{{end}}>Employee</option><option value="customer"{{if eq .SelectedRole "customer"}} selected{{end}}>Customer</option></select></div><div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Filter</button></div></form></section>
<section class="content-card"><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>User</th><th>Email</th><th>Role</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>{{$root := .}}{{range .Users}}<tr><td><span class="d-flex align-items-center gap-2"><span class="account-avatar" aria-hidden="true">{{initials .Name}}</span><strong>{{.Name}}</strong></span></td><td>{{.Email}}</td><td><span class="status-badge status-active">{{statusLabel .Role}}</span></td><td><span class="status-badge status-active">Active</span></td><td class="text-end">{{if ne .ID $root.CurrentUser.ID}}{{template "partials/action-buttons" (dict "ViewURL" (printf "/admin/users/%d" .ID) "EditURL" (printf "/admin/users/%d/edit" .ID) "DeleteDialog" (printf "delete-user-%d" .ID))}}{{else}}{{template "partials/action-buttons" (dict "ViewURL" (printf "/admin/users/%d" .ID) "EditURL" (printf "/admin/users/%d/edit" .ID))}}{{end}}{{if ne .ID $root.CurrentUser.ID}}{{template "partials/confirm-delete" (dict "ID" (printf "delete-user-%d" .ID) "Name" .Name "Message" "This revokes account access. Existing order records remain." "Action" (printf "/admin/users/%d/delete" .ID) "CSRF" $root.CSRFField)}}{{end}}</td></tr>{{else}}<tr><td colspan="5">{{template "partials/empty-state" (dict "Title" "No users found." "Description" "Try changing the search or role filter." "ActionURL" "/admin/users/new" "ActionLabel" "Add User")}}</td></tr>{{end}}</tbody></table></div></section>
{{template "layouts/admin/end" .}}
{{end}}
