{{define "admin/orders/view"}}{{template "layouts/admin/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/admin/dashboard" "HomeLabel" "Dashboard" "ParentURL" "/admin/orders" "ParentLabel" "Orders" "Current" (printf "#%d" .Order.ID))}}{{template "partials/page-header" (dict "Title" (printf "Order #%d" .Order.ID) "Description" .Order.User.Email)}}<section class="content-card mb-4"><div class="order-summary-grid"><div class="summary-item"><small>Customer</small><strong>{{if .Order.User.Name}}{{.Order.User.Name}}{{else}}{{.Order.User.Email}}{{end}}</strong></div><div class="summary-item"><small>Payment</small>{{if .Order.Payment.ID}}{{template "partials/status-badge" .Order.Payment.Status}}{{else}}<strong>—</strong>{{end}}</div><div class="summary-item"><small>Fulfillment</small>{{template "partials/status-badge" .Order.Status}}</div><div class="summary-item"><small>Total</small><strong>{{money .Order.TotalCents}}</strong></div></div></section><section class="content-card"><h2 class="h5 mb-3">Items</h2><div class="table-responsive"><table class="table data-table"><thead><tr><th>Product</th><th>SKU</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{{range .Order.Items}}<tr><td>{{.ProductName}}</td><td>{{if .ProductSKU}}{{.ProductSKU}}{{else}}—{{end}}</td><td>{{.Quantity}}</td><td>{{money .SubtotalCents}}</td></tr>{{end}}</tbody></table></div></section>{{template "layouts/admin/end" .}}{{end}}
