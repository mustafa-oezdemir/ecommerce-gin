{{define "admin/orders/index"}}{{template "layouts/admin/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/admin/dashboard" "HomeLabel" "Dashboard" "Current" "Orders")}}{{template "partials/page-header" (dict "Title" "Orders" "Description" "Review payments, fulfillment and order status.")}}<section class="table-toolbar"><form method="get" action="/admin/orders" class="row g-3 align-items-end"><div class="col-lg-4"><label class="form-label" for="order-user">Search</label><input class="form-control" id="order-user" name="user" value="{{.UserSearch}}" maxlength="100" placeholder="Customer name or email"></div><div class="col-md-4 col-lg-3"><label class="form-label" for="order-status">Status</label><select class="form-select" id="order-status" name="status"><option value="">All statuses</option>{{range .Statuses}}<option value="{{.}}"{{if eq (printf "%s" .) $.SelectedStatus}} selected{{end}}>{{statusLabel .}}</option>{{end}}</select></div><div class="col-md-4 col-lg-3"><label class="form-label" for="order-sort">Sort</label><select class="form-select" id="order-sort" name="sort"><option value="id_desc"{{if eq .SelectedSort "id_desc"}} selected{{end}}>Newest</option><option value="id_asc"{{if eq .SelectedSort "id_asc"}} selected{{end}}>Oldest</option><option value="user_asc"{{if eq .SelectedSort "user_asc"}} selected{{end}}>Customer A–Z</option><option value="total_desc"{{if eq .SelectedSort "total_desc"}} selected{{end}}>Highest total</option><option value="total_asc"{{if eq .SelectedSort "total_asc"}} selected{{end}}>Lowest total</option></select></div><div class="col-md-4 col-lg-2 d-grid"><button class="btn btn-primary" type="submit">Apply</button></div></form></section><section class="content-card"><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>Order</th><th>Customer</th><th>Payment</th><th>Status</th><th>Total</th><th class="text-end">Actions</th></tr></thead><tbody>{{range .Orders}}<tr><td><strong>#{{.ID}}</strong>{{if .OrderNumber}}<div class="small text-muted">{{.OrderNumber}}</div>{{end}}</td><td>{{if .User.Name}}{{.User.Name}}{{else}}{{.User.Email}}{{end}}<div class="small text-muted">{{.User.Email}}</div></td><td>{{if .Payment.ID}}{{template "partials/status-badge" .Payment.Status}}{{else}}<span class="text-muted">—</span>{{end}}</td><td>{{template "partials/status-badge" .Status}}</td><td class="fw-semibold">{{money .TotalCents}}</td><td class="text-end">{{template "partials/action-buttons" (dict "ViewURL" (printf "/admin/orders/%d" .ID))}}</td></tr>{{else}}<tr><td colspan="6">{{template "partials/empty-state" (dict "Title" "No orders found." "Description" "Try changing the filters.")}}</td></tr>{{end}}</tbody></table></div>{{template "partials/pagination" .}}</section>{{template "layouts/admin/end" .}}{{end}}
