{{define "order_success.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Order Complete | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f0fdf4 0%, #f8fafc 100%); }
    .success-card { border: 0; border-radius: 1.5rem; box-shadow: 0 18px 40px rgba(22, 163, 74, 0.12); }
  </style>
</head>
<body>
  {{template "site-nav" .}}
  <main class="app-main container py-5 d-flex align-items-center">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card success-card border-success-subtle">
          <div class="card-body text-center p-5">
            <div class="mb-4">
              <div class="rounded-circle bg-success-subtle text-success mx-auto d-flex align-items-center justify-content-center" style="width: 88px; height: 88px; font-size: 2.3rem;">✓</div>
            </div>
            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">Order Received</span>
            <h1 class="h2 mt-3 mb-3">Thank you!</h1>
            <p class="text-muted mb-4">Your order <strong>#{{.Order.ID}}</strong> has been successfully placed.</p>
            <div class="fs-5 fw-bold mb-4">Total: {{money .Order.TotalCents}}</div>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
              <a href="/account/orders/{{.Order.ID}}" class="btn btn-primary">View Order</a>
              <a href="/" class="btn btn-outline-secondary">Continue Shopping</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
