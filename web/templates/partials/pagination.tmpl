{{define "partials/pagination"}}{{if .TotalPages}}{{if gt .TotalPages 1}}<nav class="app-pagination" aria-label="Pagination"><ul class="pagination justify-content-center mb-2"><li class="page-item{{if eq .Page 1}} disabled{{end}}">{{if gt .Page 1}}<a class="page-link" href="?{{.PaginationQuery}}&page={{sub .Page 1}}">Previous</a>{{else}}<span class="page-link">Previous</span>{{end}}</li>{{range .PageNumbers}}<li class="page-item{{if eq . $.Page}} active{{end}}"><a class="page-link" href="?{{$.PaginationQuery}}&page={{.}}"{{if eq . $.Page}} aria-current="page"{{end}}>{{.}}</a></li>{{end}}<li class="page-item{{if eq .Page .TotalPages}} disabled{{end}}">{{if lt .Page .TotalPages}}<a class="page-link" href="?{{.PaginationQuery}}&page={{add .Page 1}}">Next</a>{{else}}<span class="page-link">Next</span>{{end}}</li></ul><p class="text-muted small text-center mb-0">Page {{.Page}} of {{.TotalPages}}</p></nav>{{end}}{{end}}{{end}}
