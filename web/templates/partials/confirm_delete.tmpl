{{define "partials/confirm-delete"}}<dialog class="confirm-dialog" id="{{.ID}}" aria-labelledby="{{.ID}}-title"><form method="dialog" class="confirm-dialog-close"><button class="btn-close" aria-label="Close"></button></form><h2 class="h4" id="{{.ID}}-title">Delete {{.Name}}?</h2><p class="text-muted">{{.Message}}</p><div class="d-flex justify-content-end gap-2"><form method="dialog"><button class="btn btn-outline-secondary">Cancel</button></form><form method="post" action="{{.Action}}">{{.CSRF}}<button class="btn btn-danger" type="submit">Confirm delete</button></form></div></dialog>{{end}}
