{{define "two_factor.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Two-Factor Authentication | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
  <style>
    body { min-height: 100vh; background: linear-gradient(135deg, #eef2ff, #f8fafc); }
    .security-card { border: 0; border-radius: 1.4rem; box-shadow: 0 20px 60px rgba(79,70,229,.14); }
    .recovery-code { font-family: ui-monospace, monospace; background: #111827; color: #fff; border-radius: .6rem; padding: .65rem; }
  </style>
</head>
<body>
  {{template "site-nav" .}}
  <main class="app-main container py-5">
    <div class="card security-card mx-auto" style="max-width: 720px;">
      <div class="card-body p-4 p-lg-5">
        <a class="btn btn-sm btn-link px-0 mb-2" href="/account">← Back to account</a>
        <h1 class="h3">Two-Factor Authentication</h1>
        {{if .error}}<div class="alert alert-danger" role="alert">{{.error}}</div>{{end}}
        {{if .success}}<div class="alert alert-success" role="status">{{.success}}</div>{{end}}

        {{if .RecoveryCodes}}
        <section class="mb-4">
          <h2 class="h5">Save your recovery codes</h2>
          <p class="text-muted">Each code works once. Store them in a password manager; they will not be shown again.</p>
          <div class="row g-2">{{range .RecoveryCodes}}<div class="col-sm-6"><div class="recovery-code">{{.}}</div></div>{{end}}</div>
        </section>
        {{end}}

        {{if .User.TwoFactorEnabled}}
        <span class="badge text-bg-success mb-3">Status: Enabled</span>
        <p class="text-muted">Your account is protected with an authenticator application.</p>
        <section class="border rounded-4 p-3 mb-4">
          <h2 class="h5">Generate new recovery codes</h2>
          <p class="small text-muted">Existing recovery codes will stop working.</p>
          <form method="post" action="/account/recovery-codes">
            {{.CSRFField}}
            <label class="form-label" for="recovery-password">Current password</label>
            <div class="input-group"><input class="form-control" id="recovery-password" type="password" name="current_password" maxlength="72" autocomplete="current-password" required><button class="btn btn-outline-primary">Generate</button></div>
          </form>
        </section>
        <section class="border border-danger-subtle rounded-4 p-3">
          <h2 class="h5 text-danger">Disable two-factor authentication</h2>
          <p class="small text-muted">Confirm with your password and a current authenticator code.</p>
          <form method="post" action="/account/two-factor/disable">
            {{.CSRFField}}
            <div class="mb-2"><label class="form-label" for="disable-password">Current password</label><input class="form-control" id="disable-password" type="password" name="current_password" maxlength="72" autocomplete="current-password" required></div>
            <div class="mb-3"><label class="form-label" for="disable-code">Authentication code</label><input class="form-control" id="disable-code" name="code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" autocomplete="one-time-code" required></div>
            <button class="btn btn-outline-danger">Disable Two-Factor Authentication</button>
          </form>
        </section>
        {{else}}
        <span class="badge text-bg-secondary mb-3">Status: Not enabled</span>
        <p class="text-muted">Add additional security to your account using Google Authenticator, Microsoft Authenticator, Authy, 1Password, or another TOTP-compatible application.</p>
        <form method="post" action="/account/two-factor">
          {{.CSRFField}}
          <button class="btn btn-primary">Enable Two-Factor Authentication</button>
        </form>
        {{end}}
      </div>
    </div>
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
