{{define "account.tmpl"}}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hesabım | NordShop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .profile-card { border: 0; border-radius: 1.25rem; box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08); }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">NordShop</a>
      <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/">Ürünler</a>
        <a class="btn btn-outline-light btn-sm" href="/cart">Sepet</a>
        <a class="btn btn-outline-light btn-sm" href="/account">Hesabım</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Profil</span>
        <h1 class="h2 mt-3 mb-0">Hesabım</h1>
      </div>
      <a href="/account/orders" class="btn btn-outline-primary">Siparişlerim</a>
    </div>

    <div class="row g-4">
      <div class="col-lg-4">
        <div class="card profile-card h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
              <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; font-weight: 700;">{{printf "%.1s" .User.Name}}</div>
              <div class="ms-3">
                <h2 class="h5 mb-0">{{.User.Name}}</h2>
                <small class="text-muted">{{.User.Email}}</small>
              </div>
            </div>
            <div class="list-group list-group-flush">
              <div class="list-group-item px-0">
                <small class="text-muted d-block">Rol</small>
                <span class="fw-semibold text-capitalize">{{.User.Role}}</span>
              </div>
              <div class="list-group-item px-0">
                <small class="text-muted d-block">Durum</small>
                <span class="badge bg-success-subtle text-success rounded-pill">Aktif</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="card profile-card mb-4">
          <div class="card-body p-4">
            <h2 class="h5 mb-3">Profil bilgileri</h2>
            <form method="post" action="/account/profile">
              {{.CSRFField}}
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Ad</label>
                  <input class="form-control" name="name" value="{{.User.Name}}" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">E-posta</label>
                  <input class="form-control" type="email" name="email" value="{{.User.Email}}" required>
                </div>
              </div>
              <button type="submit" class="btn btn-primary mt-3">Kaydet</button>
            </form>
          </div>
        </div>

        <div class="card profile-card">
          <div class="card-body p-4">
            <h2 class="h5 mb-3">Şifre değiştir</h2>
            <form method="post" action="/account/password">
              {{.CSRFField}}
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Mevcut şifre</label>
                  <input class="form-control" name="current_password" type="password" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Yeni şifre</label>
                  <input class="form-control" name="new_password" type="password" minlength="12" required>
                </div>
              </div>
              <button type="submit" class="btn btn-outline-primary mt-3">Şifreyi değiştir</button>
            </form>

            <form method="post" action="/logout" class="mt-4">
              {{.CSRFField}}
              <button type="submit" class="btn btn-outline-danger">Çıkış yap</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
{{end}}
