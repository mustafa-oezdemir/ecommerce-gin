{{define "account.tmpl"}}
<!doctype html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Account & Security | NordShop</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="/static/account.js" defer></script>
<style>body{background:#f4f7fb}.shell{max-width:1100px}.card{border:0;border-radius:1.2rem;box-shadow:0 12px 35px rgba(15,23,42,.07)}.icon{width:44px;height:44px;border-radius:12px;background:#eef2ff;color:#4f46e5;display:grid;place-items:center;font-weight:800}.danger{border:1px solid #fecaca}.code{font-family:ui-monospace,monospace;background:#111827;color:#fff;border-radius:.6rem;padding:.6rem}</style>
</head><body>
<nav class="navbar navbar-dark bg-dark"><div class="container shell"><a class="navbar-brand fw-bold" href="/">NordShop</a><div class="d-flex gap-2"><a class="btn btn-outline-light btn-sm" href="/account/orders">Orders</a><a class="btn btn-outline-light btn-sm" href="/account/lists">Lists</a></div></div></nav>
<main class="container shell py-5">
<div class="mb-4"><span class="badge text-bg-primary rounded-pill">Account center</span><h1 class="display-6 fw-bold mt-2">Profile & security</h1><p class="text-muted">Manage your identity, sign-in protection, and account data.</p></div>
{{if .error}}<div class="alert alert-danger" role="alert">{{.error}}</div>{{end}}{{if .success}}<div class="alert alert-success" role="status">{{.success}}</div>{{end}}
{{if .RecoveryCodes}}<section class="card mb-4"><div class="card-body p-4"><h2 class="h5">Save your recovery codes</h2><p class="text-muted">Each code works once. Store them in a password manager.</p><div class="row g-2">{{range .RecoveryCodes}}<div class="col-md-6"><div class="code">{{.}}</div></div>{{end}}</div></div></section>{{end}}
<div class="row g-4"><div class="col-lg-6">
<section class="card mb-4"><div class="card-body p-4"><div class="d-flex gap-3"><div class="icon">ID</div><div class="flex-grow-1"><h2 class="h5">Profile</h2><form method="post" action="/account/profile">{{.CSRFField}}<div class="row g-3"><div class="col-sm-6"><label class="form-label">First name</label><input class="form-control" name="first_name" value="{{.User.FirstName}}" maxlength="100" required></div><div class="col-sm-6"><label class="form-label">Last name</label><input class="form-control" name="last_name" value="{{.User.LastName}}" maxlength="100" required></div></div><button class="btn btn-primary mt-3">Save profile</button></form></div></div></div></section>
<section class="card mb-4"><div class="card-body p-4"><h2 class="h5">Email address</h2><p class="text-muted small">Current: {{.User.Email}}. The new address is activated only after verification.</p><form method="post" action="/account/email">{{.CSRFField}}<input class="form-control mb-2" type="email" name="email" placeholder="New email" required><input class="form-control mb-2" type="password" name="current_password" placeholder="Current password" required><button class="btn btn-outline-primary">Send verification code</button></form><hr><form method="post" action="/account/email/confirm">{{.CSRFField}}<div class="input-group"><input class="form-control" name="code" placeholder="Security code (for example ABC-234)" required><button class="btn btn-primary">Confirm email</button></div></form></div></section>
</div><div class="col-lg-6">
<section class="card mb-4"><div class="card-body p-4"><h2 class="h5">Password</h2><form method="post" action="/account/password">{{.CSRFField}}<input class="form-control mb-2" type="password" name="current_password" placeholder="Current password" autocomplete="current-password" required><input class="form-control mb-2" type="password" name="new_password" minlength="12" maxlength="72" placeholder="New password (12+ characters)" autocomplete="new-password" required><input class="form-control mb-2" type="password" name="password_confirmation" minlength="12" maxlength="72" placeholder="Confirm new password" autocomplete="new-password" required><button class="btn btn-outline-primary">Change password</button></form></div></section>
<section class="card mb-4"><div class="card-body p-4"><h2 class="h5">Two-factor authentication</h2>{{if .User.TwoFactorEnabled}}<span class="badge text-bg-success mb-3">Enabled</span><form method="post" action="/account/recovery-codes" class="mb-3">{{.CSRFField}}<input class="form-control mb-2" type="password" name="current_password" placeholder="Current password" required><button class="btn btn-outline-primary">Generate new recovery codes</button></form><form method="post" action="/account/two-factor/disable">{{.CSRFField}}<input class="form-control mb-2" type="password" name="current_password" placeholder="Current password" required><input class="form-control mb-2" name="code" inputmode="numeric" placeholder="Authenticator code" required><button class="btn btn-outline-danger">Disable 2FA</button></form>{{else}}<p class="text-muted">Protect your account with an authenticator app and single-use recovery codes.</p><form method="post" action="/account/two-factor">{{.CSRFField}}<button class="btn btn-primary">Set up 2FA</button></form>{{end}}</div></section>
</div></div>
<section class="card mt-2 mb-4"><div class="card-body p-4"><h2 class="h5">Active session security</h2><p class="text-muted mb-0">This browser uses an HTTP-only, SameSite session. Password, email, recovery-code, and two-factor changes automatically invalidate older sessions on other devices.</p></div></section>
<section class="card danger mt-2"><div class="card-body p-4"><h2 class="h5 text-danger">Delete account</h2><p class="text-muted small">This action removes access to your account and cannot be undone.</p><form id="delete-account-form" method="post" action="/account/delete">{{.CSRFField}}<div class="input-group"><input class="form-control" type="password" name="current_password" placeholder="Current password" required><button class="btn btn-danger">Delete account</button></div></form></div></section>
</main></body></html>{{end}}
