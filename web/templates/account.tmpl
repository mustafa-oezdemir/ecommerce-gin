{{define "account.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Profile & Security | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
  <script src="/static/account.js" defer></script>
  <style>
    body { background: #f4f7fb; }
    .account-shell { max-width: 1100px; }
    .account-card { border: 0; border-radius: 1.2rem; box-shadow: 0 12px 35px rgba(15,23,42,.07); }
    .section-icon { width: 44px; height: 44px; flex: 0 0 auto; border-radius: 12px; background: #eef2ff; color: #4f46e5; display: grid; place-items: center; font-weight: 800; }
    .danger-card { border: 1px solid #fecaca; }
    .recovery-code { font-family: ui-monospace, monospace; background: #111827; color: #fff; border-radius: .6rem; padding: .6rem; }
  </style>
</head>
<body>
  {{template "site-nav" .}}
  <main class="app-main container account-shell py-5">
    <div class="mb-4">
      <span class="badge text-bg-primary rounded-pill">My Account</span>
      <h1 class="display-6 fw-bold mt-2 mb-1">Profile & Security</h1>
      <p class="text-muted mb-0">Manage your personal information and sign-in protection.</p>
    </div>

    {{if .error}}<div class="alert alert-danger" role="alert">{{.error}}</div>{{end}}
    {{if .success}}<div class="alert alert-success" role="status">{{.success}}</div>{{end}}
    {{if .RecoveryCodes}}<section class="card account-card mb-4"><div class="card-body p-4"><h2 class="h5">Save your recovery codes</h2><p class="text-muted">Each code works once. Store them in a password manager.</p><div class="row g-2">{{range .RecoveryCodes}}<div class="col-md-6"><div class="recovery-code">{{.}}</div></div>{{end}}</div></div></section>{{end}}

    <div class="row g-4">
      <div class="col-lg-6">
        <section class="card account-card mb-4">
          <div class="card-body p-4">
            <div class="d-flex gap-3">
              <div class="section-icon">ID</div>
              <div class="flex-grow-1">
                <h2 class="h5">Profile Information</h2>
                <p class="small text-muted">These values are loaded from your authenticated account.</p>
                <form method="post" action="/account/profile">
                  {{.CSRFField}}
                  <div class="row g-3">
                    <div class="col-sm-6"><label class="form-label" for="first-name">First name</label><input class="form-control" id="first-name" name="first_name" value="{{.User.FirstName}}" minlength="1" maxlength="100" autocomplete="given-name" required></div>
                    <div class="col-sm-6"><label class="form-label" for="last-name">Last name</label><input class="form-control" id="last-name" name="last_name" value="{{.User.LastName}}" minlength="1" maxlength="100" autocomplete="family-name" required></div>
                    <div class="col-12"><label class="form-label" for="profile-email">Email</label><input class="form-control" id="profile-email" type="email" value="{{.User.Email}}" readonly aria-describedby="email-help"><div class="form-text" id="email-help">Use the secure email change form below to update this address.</div></div>
                  </div>
                  <button class="btn btn-primary mt-3" type="submit">Save Profile</button>
                </form>
              </div>
            </div>
          </div>
        </section>

        <section class="card account-card mb-4">
          <div class="card-body p-4">
            <h2 class="h5">Email Address</h2>
            <p class="text-muted small">The new address is activated only after password confirmation and email verification.</p>
            <form method="post" action="/account/email">
              {{.CSRFField}}
              <div class="mb-2"><label class="form-label" for="new-email">New email</label><input class="form-control" id="new-email" type="email" name="email" maxlength="254" autocomplete="email" required></div>
              <div class="mb-3"><label class="form-label" for="email-password">Current password</label><input class="form-control" id="email-password" type="password" name="current_password" maxlength="72" autocomplete="current-password" required></div>
              <button class="btn btn-outline-primary" type="submit">Send Verification Code</button>
            </form>
            <hr>
            <form method="post" action="/account/email/confirm">
              {{.CSRFField}}
              <label class="form-label" for="email-code">Email verification code</label>
              <div class="input-group"><input class="form-control" id="email-code" name="code" minlength="6" maxlength="32" autocomplete="one-time-code" required><button class="btn btn-primary" type="submit">Confirm Email</button></div>
            </form>
          </div>
        </section>
      </div>

      <div class="col-lg-6">
        <section class="card account-card mb-4">
          <div class="card-body p-4">
            <h2 class="h5">Update Password</h2>
            <p class="small text-muted">Use at least 12 characters and choose a password different from your current one.</p>
            <form method="post" action="/account/password">
              {{.CSRFField}}
              <div class="mb-2"><label class="form-label" for="current-password">Current password</label><input class="form-control" id="current-password" type="password" name="current_password" maxlength="72" autocomplete="current-password" required></div>
              <div class="mb-2"><label class="form-label" for="new-password">New password</label><input class="form-control" id="new-password" type="password" name="new_password" minlength="12" maxlength="72" autocomplete="new-password" required></div>
              <div class="mb-3"><label class="form-label" for="confirm-password">Confirm new password</label><input class="form-control" id="confirm-password" type="password" name="password_confirmation" minlength="12" maxlength="72" autocomplete="new-password" required></div>
              <button class="btn btn-primary" type="submit">Update Password</button>
            </form>
          </div>
        </section>

        <section class="card account-card mb-4">
          <div class="card-body p-4">
            <h2 class="h5">Two-Factor Authentication</h2>
            {{if .User.TwoFactorEnabled}}
            <span class="badge text-bg-success mb-3">Status: Enabled</span>
            <p class="text-muted">Your account is protected with an authenticator application.</p>
            <a class="btn btn-outline-primary" href="/account/two-factor">Manage Two-Factor Authentication</a>
            {{else}}
            <span class="badge text-bg-secondary mb-3">Status: Not enabled</span>
            <p class="text-muted">Add additional security to your account using an authenticator application.</p>
            <a class="btn btn-primary" href="/account/two-factor">Configure Two-Factor Authentication</a>
            {{end}}
          </div>
        </section>

        <section class="card account-card mb-4">
          <div class="card-body p-4">
            <h2 class="h5">Active Session Security</h2>
            <p class="text-muted mb-0">This browser uses an HTTP-only, SameSite session. Password, email, recovery-code, and two-factor changes invalidate older sessions on other devices.</p>
          </div>
        </section>
      </div>
    </div>

    <section class="card account-card danger-card">
      <div class="card-body p-4">
        <h2 class="h5 text-danger">Delete Account</h2>
        <p class="text-muted small">This action removes access to your account and cannot be undone.</p>
        <form id="delete-account-form" method="post" action="/account/delete">
          {{.CSRFField}}
          <div class="input-group"><input class="form-control" type="password" name="current_password" maxlength="72" autocomplete="current-password" placeholder="Current password" aria-label="Current password" required><button class="btn btn-danger" type="submit">Delete Account</button></div>
        </form>
      </div>
    </section>
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
