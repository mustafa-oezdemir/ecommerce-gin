{{define "account/addresses/form"}}<form method="post" action="{{.Action}}" class="row g-3">{{.CSRF}}<div class="col-md-6"><label class="form-label" for="address-first-name">First Name</label><input class="form-control" id="address-first-name" name="first_name" value="{{.Address.FirstName}}" maxlength="100" required></div><div class="col-md-6"><label class="form-label" for="address-last-name">Last Name</label><input class="form-control" id="address-last-name" name="last_name" value="{{.Address.LastName}}" maxlength="100" required></div><div class="col-md-6"><label class="form-label" for="address-company">Company</label><input class="form-control" id="address-company" name="company" value="{{.Address.Company}}" maxlength="150"></div><div class="col-md-6"><label class="form-label" for="address-phone">Phone</label><input class="form-control" id="address-phone" name="phone" value="{{.Address.Phone}}" maxlength="32" required></div><div class="col-md-8"><label class="form-label" for="address-street">Street</label><input class="form-control" id="address-street" name="street" value="{{.Address.Street}}" maxlength="150" required></div><div class="col-md-4"><label class="form-label" for="address-house-number">House Number</label><input class="form-control" id="address-house-number" name="house_number" value="{{.Address.HouseNumber}}" maxlength="30" required></div><div class="col-12"><label class="form-label" for="address-addition">Address Addition</label><input class="form-control" id="address-addition" name="address_line_2" value="{{.Address.AddressLine2}}" maxlength="150"></div><div class="col-md-4"><label class="form-label" for="address-postal-code">Postal Code</label><input class="form-control" id="address-postal-code" name="postal_code" value="{{.Address.PostalCode}}" maxlength="20" required></div><div class="col-md-4"><label class="form-label" for="address-city">City</label><input class="form-control" id="address-city" name="city" value="{{.Address.City}}" maxlength="100" required></div><div class="col-md-4"><label class="form-label" for="address-state">State / Region</label><input class="form-control" id="address-state" name="state" value="{{.Address.State}}" maxlength="100"></div><div class="col-md-4"><label class="form-label" for="address-country">Country</label><input class="form-control text-uppercase" id="address-country" name="country_code" value="{{.Address.CountryCode}}" minlength="2" maxlength="2" required></div><div class="col-md-8 d-flex align-items-end"><label class="form-check mb-2"><input class="form-check-input" type="checkbox" name="is_default" value="true"{{if .Address.IsDefault}} checked{{end}}> Set as default address</label></div><div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary" href="/account/addresses">Cancel</a><button class="btn btn-primary" type="submit">{{if .Editing}}Save changes{{else}}Add address{{end}}</button></div></form>{{end}}
