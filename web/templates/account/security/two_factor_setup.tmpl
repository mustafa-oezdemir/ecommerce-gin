{{define "account/security/two-factor-setup"}}
{{template "layouts/account/start" .}}

<div class="card mx-auto" style="max-width: 620px;">
            <div class="card-body p-4 p-lg-5">

                <span class="badge text-bg-primary rounded-pill">
                    Security setup
                </span>

                <h1 class="h3 mt-3">
                    Connect your authenticator
                </h1>

                <ol class="text-muted">
                    <li>Scan this QR code in your authenticator app.</li>
                    <li>Enter the current six-digit code below.</li>
                    <li>Save the recovery codes shown after confirmation.</li>
                </ol>

                {{ if .error }}
                <div class="alert alert-danger" role="alert">
                    {{ .error }}
                </div>
                {{ end }}

                <div class="text-center my-4">
                    <img
                        src="data:image/png;base64,{{ .TwoFactorQRBase64 }}"
                        width="240"
                        height="240"
                        alt="Two-factor authentication QR code"
                    >

                    <p class="small mt-2">
                        Manual key:
                        <code>{{ .TwoFactorSecret }}</code>
                    </p>
                </div>

                <form method="post" action="/account/two-factor/confirm">
                    {{ .CSRFField }}

                    <label for="code" class="form-label">
                        Authentication code
                    </label>

                    <div class="input-group">
                        <input
                            id="code"
                            class="form-control form-control-lg"
                            type="text"
                            name="code"
                            inputmode="numeric"
                            pattern="[0-9]{6}"
                            autocomplete="one-time-code"
                            minlength="6"
                            maxlength="6"
                            required
                        >

                        <button type="submit" class="btn btn-primary">
                            Enable 2FA
                        </button>
                    </div>
                </form>

                <a class="btn btn-link mt-3" href="/account/two-factor">
                    Cancel
                </a>

            </div>
        </div>
{{template "layouts/account/end" .}}
{{end}}
