{{define "account/orders/index"}}{{template "layouts/account/start" .}}{{template "partials/breadcrumbs" (dict "HomeURL" "/account" "HomeLabel" "Account" "Current" "Orders")}}{{template "partials/page-header" (dict "Title" "My Orders" "Description" "Review purchases, payments and deliveries.")}}{{if .Orders}}<div class="row g-4">{{range .Orders}}<div class="col-12"><article class="content-card"><div class="d-flex flex-column flex-lg-row justify-content-between gap-4"><div><div class="small text-muted">Order</div><h2 class="h5 mb-1">#{{.ID}}</h2><time class="small text-muted" datetime="{{.CreatedAt.Format "2006-01-02"}}">{{.CreatedAt.Format "02.01.2006"}}</time></div><div class="order-summary-grid flex-grow-1"><div class="summary-item"><small>Payment</small>{{if .Payment.ID}}{{template "partials/status-badge" .Payment.Status}}{{else}}<strong>Pending</strong>{{end}}</div><div class="summary-item"><small>Delivery</small>{{if .Shipment.ID}}{{template "partials/status-badge" .Shipment.Status}}{{else}}{{template "partials/status-badge" .Status}}{{end}}</div><div class="summary-item"><small>Total</small><strong>{{money .TotalCents}}</strong></div><div class="summary-item"><small>Items</small><strong>{{len .Items}}</strong></div></div><div class="action-buttons align-self-lg-center"><a class="btn btn-outline-primary" href="/account/orders/{{.ID}}">View Order</a>{{if .Shipment.TrackingNumber}}<a class="btn btn-outline-secondary" href="/account/orders/{{.ID}}#shipment">Track Shipment</a>{{end}}</div></div></article></div>{{end}}</div>{{else}}{{template "partials/empty-state" (dict "Title" "No orders yet." "Description" "Your purchases will appear here." "ActionURL" "/" "ActionLabel" "Start shopping")}}{{end}}{{template "layouts/account/end" .}}{{end}}
