{{define "account/orders/view"}}
{{template "layouts/account/start" .}}
{{template "partials/breadcrumbs" (dict "HomeURL" "/account" "HomeLabel" "Account" "ParentURL" "/account/orders" "ParentLabel" "Orders" "Current" (printf "#%d" .Order.ID))}}
{{template "partials/page-header" (dict "Title" (printf "Order #%d" .Order.ID) "Description" "Order, payment and delivery details.")}}
{{if .ShippingUnavailable}}<div class="alert alert-warning" role="status">Shipment tracking is temporarily unavailable. Your order details remain available.</div>{{end}}
<section class="content-card mb-4"><h2 class="h5 mb-3">Order Summary</h2><div class="order-summary-grid"><div class="summary-item"><small>Order status</small>{{template "partials/status-badge" .Order.Status}}</div><div class="summary-item"><small>Payment</small>{{if .Order.Payment.ID}}{{template "partials/status-badge" .Order.Payment.Status}}{{else}}<strong>Pending</strong>{{end}}</div><div class="summary-item"><small>Placed</small><strong>{{.Order.CreatedAt.Format "02.01.2006"}}</strong></div><div class="summary-item"><small>Total</small><strong>{{money .Order.TotalCents}}</strong></div></div></section>
{{if .Shipment}}<section class="shipment-card mb-4" id="shipment"><div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><h2 class="h5 mb-1">Shipment</h2><p class="text-muted mb-0">Live delivery summary</p></div>{{if .ShipmentTrackingURL}}<a class="btn btn-outline-primary" href="{{.ShipmentTrackingURL}}">Open public tracking</a>{{end}}</div><div class="shipment-summary-grid"><div class="summary-item"><small>Tracking Number</small><strong class="font-monospace">{{.Shipment.TrackingNumber}}</strong></div><div class="summary-item"><small>Current Status</small><span class="status-badge status-{{.Shipment.Status}}">{{.Shipment.StatusLabel}}</span></div><div class="summary-item"><small>Expected Delivery</small><strong>{{if .Shipment.EstimatedFrom}}{{.Shipment.EstimatedFrom.Format "02 Jan 15:04"}}{{if .Shipment.EstimatedUntil}}–{{.Shipment.EstimatedUntil.Format "15:04"}}{{end}}{{else}}To be confirmed{{end}}</strong></div><div class="summary-item"><small>Remaining Stops</small><strong>{{if .Shipment.RemainingStops}}{{.Shipment.RemainingStops}}{{else}}—{{end}}</strong></div></div>{{if .ShipmentQRCodeURL}}<img class="mt-3" src="{{.ShipmentQRCodeURL}}" alt="Shipment QR code" width="112" height="112" loading="lazy">{{end}}</section>{{end}}
{{if .ShipmentTimeline}}<section class="content-card mb-4"><h2 class="h5 mb-3">Shipment Timeline</h2><div class="table-responsive timeline-desktop"><table class="table data-table"><thead><tr><th>Date & Time</th><th>Status</th><th>Location</th><th>Details</th></tr></thead><tbody>{{range .ShipmentTimeline}}<tr><td><time datetime="{{.OccurredAt.Format "2006-01-02T15:04:05Z07:00"}}">{{.OccurredAt.Format "02.01.2006 15:04"}}</time></td><td><span class="status-badge status-{{.Status}}">{{.Title}}</span></td><td>{{if .Location}}{{.Location}}{{else}}—{{end}}</td><td>{{if .Description}}{{.Description}}{{else if .RemainingStops}}{{.RemainingStops}} stops remaining{{else}}—{{end}}</td></tr>{{end}}</tbody></table></div><ol class="timeline-mobile list-unstyled mb-0">{{range .ShipmentTimeline}}<li class="d-flex gap-3 pb-4"><span class="timeline-dot" aria-hidden="true"></span><div><strong class="d-block">{{.Title}}</strong><time class="small text-muted" datetime="{{.OccurredAt.Format "2006-01-02T15:04:05Z07:00"}}">{{.OccurredAt.Format "02.01.2006 15:04"}}</time>{{if .Location}}<div>{{.Location}}</div>{{end}}{{if .RemainingStops}}<div class="small text-muted">{{.RemainingStops}} stops remaining</div>{{end}}</div></li>{{end}}</ol></section>{{end}}
<section class="content-card mb-4"><h2 class="h5 mb-3">Items</h2><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>Product</th><th>Unit Price</th><th>Quantity</th><th>Subtotal</th></tr></thead><tbody>{{range .Order.Items}}<tr><td><div class="d-flex align-items-center gap-3">{{if .Product.ID}}<a class="order-product-link" href="/products/{{.ProductID}}" aria-label="View {{.ProductName}}">{{if .Product.ImageFilename}}<img class="order-product-image" src="/media/products/{{.Product.ImageFilename}}" alt="{{.ProductName}}" loading="lazy">{{else}}<span class="order-product-image order-product-placeholder" aria-hidden="true">{{initials .ProductName}}</span>{{end}}</a><div><a class="order-product-link fw-semibold" href="/products/{{.ProductID}}">{{.ProductName}}</a>{{if .ProductSKU}}<div class="small text-muted">{{.ProductSKU}}</div>{{end}}</div>{{else}}<strong>{{.ProductName}}</strong>{{end}}</div></td><td>{{money .UnitPriceCents}}</td><td>{{.Quantity}}</td><td>{{money .SubtotalCents}}</td></tr>{{end}}</tbody></table></div></section>
{{if .Order.Addresses}}<div class="row g-4 mb-4">{{range .Order.Addresses}}<div class="col-md-6"><section class="address-card h-100"><h2 class="h5">{{statusLabel .Type}} Address</h2><address class="mb-0">{{.FirstName}} {{.LastName}}<br>{{if .Company}}{{.Company}}<br>{{end}}{{.Street}} {{.HouseNumber}}<br>{{if .AddressLine2}}{{.AddressLine2}}<br>{{end}}{{.PostalCode}} {{.City}}<br>{{.CountryCode}}</address></section></div>{{end}}</div>{{end}}
{{if .ReturnShipment}}<section class="shipment-card mb-4"><h2 class="h5">Return Information</h2><div class="shipment-summary-grid"><div class="summary-item"><small>Tracking</small><strong>{{.ReturnShipment.TrackingNumber}}</strong></div><div class="summary-item"><small>Status</small><span class="status-badge status-{{.ReturnShipment.Status}}">{{.ReturnShipment.StatusLabel}}</span></div></div>{{if .ReturnTrackingURL}}<a class="btn btn-outline-primary mt-3" href="{{.ReturnTrackingURL}}">Track return</a>{{end}}</section>{{end}}
{{if or .CanConfirmDelivery .CanRequestReturn .CanCancelOrder}}<section class="form-card"><h2 class="h5 mb-3">Order actions</h2>{{if .CanConfirmDelivery}}<form method="post" action="/account/orders/{{.Order.ID}}/confirm-delivery" class="mb-3">{{.CSRFField}}<button class="btn btn-success" type="submit">Confirm delivery</button></form>{{end}}{{if .CanRequestReturn}}<form method="post" action="/account/orders/{{.Order.ID}}/return">{{.CSRFField}}{{range .Order.Items}}<div class="input-group mb-2"><div class="input-group-text"><input class="form-check-input mt-0" type="checkbox" name="return_item_id" value="{{.ID}}" aria-label="Return {{.ProductName}}"></div><span class="form-control">{{.ProductName}}</span><input class="form-control" type="number" name="return_quantity_{{.ID}}" min="1" max="{{.Quantity}}" value="1" aria-label="Quantity for {{.ProductName}}"></div>{{end}}<select class="form-select mb-2" name="reason" aria-label="Return reason" required><option value="" selected disabled>Return reason</option><option value="damaged">Damaged</option><option value="wrong_item">Wrong item</option><option value="not_as_described">Not as described</option><option value="does_not_fit">Does not fit</option><option value="changed_mind">Changed mind</option><option value="defective">Defective</option><option value="other">Other</option></select><input class="form-control mb-2" name="note" maxlength="1000" placeholder="Optional note"><button class="btn btn-outline-primary" type="submit">Start return</button></form>{{end}}{{if .CanCancelOrder}}<form method="post" action="/account/orders/{{.Order.ID}}/cancel" class="mt-3">{{.CSRFField}}<button class="btn btn-outline-danger" type="submit">Cancel order</button></form>{{end}}</section>{{end}}
{{template "layouts/account/end" .}}
{{end}}
