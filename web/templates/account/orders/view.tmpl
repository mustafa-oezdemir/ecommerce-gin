{{ define "account/orders/view" }}
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Order Details | PehliOne</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link href="/static/site.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .detail-card { border: 0; border-radius: 1.25rem; box-shadow: 0 12px 30px rgba(15,23,42,0.08); }
    .order-product-image { width: 64px; height: 64px; object-fit: cover; border-radius: .75rem; background: #eef2ff; }
    .order-product-placeholder { display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #e0e7ff, #e0f2fe); color: #4f46e5; font-weight: 700; }
    .order-product-link { color: inherit; text-decoration: none; }
    .order-product-link:hover .order-product-image, .order-product-link:focus-visible .order-product-image { outline: 3px solid #f97316; outline-offset: 2px; }
  </style>
	</head>
	<body>
		{{ template "site-nav" . }}

		<main class="app-main container py-5">
			{{ if .ShippingUnavailable }}<div class="alert alert-warning" role="status">Shipment tracking is temporarily unavailable. Your order details remain available below.</div>{{ end }}
			<div class="d-flex justify-content-between align-items-center mb-4">
				<div>
					<span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Order</span>
					<h1 class="h2 mt-3 mb-0">Order #{{ .Order.ID }}</h1>
				</div>
				{{ if .Shipment }}
					<div class="card detail-card mb-4">
						<div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
							<div>
								<h2 class="h5 mb-1">Shipment</h2>
								<div class="small text-muted">Tracking number</div>
								<div class="fw-semibold font-monospace">{{ .Shipment.TrackingNumber }}</div>
							</div>
							<div>
								<div class="small text-muted">Status</div>
								<div class="fw-semibold">{{ .Shipment.StatusLabel }}</div>
								{{ if .Shipment.RemainingStops }}<div class="small text-muted">{{ .Shipment.RemainingStops }} stops remaining</div>{{ end }}
								{{ if .Shipment.EstimatedFrom }}<div class="small text-muted">Estimated: {{ .Shipment.EstimatedFrom.Format "02 Jan 15:04" }}</div>{{ end }}
							</div>
							{{ if .ShipmentTrackingURL }}<a class="btn btn-outline-primary" href="{{ .ShipmentTrackingURL }}">Track shipment</a>{{ end }}
							{{ if .ShipmentQRCodeURL }}<img src="{{ .ShipmentQRCodeURL }}" alt="Shipment QR code" width="128" height="128" loading="lazy">{{ end }}
						</div>
					</div>
				{{ end }}
				<a href="/account/orders" class="btn btn-outline-secondary">Back</a>
			</div>

			<div class="card detail-card mb-4">
				<div class="card-body p-4">
					<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
						<div>
							<div class="text-muted small">Status</div>
							<div class="fw-semibold">{{ .Order.Status }}</div>
							{{ if .Order.Payment.ID }}<div class="small text-muted">Payment: {{ .Order.Payment.Status }} ({{ .Order.Payment.Method }})</div>{{ end }}
						</div>
						<div class="text-end">
							<div class="text-muted small">Total</div>
							<div class="fw-bold fs-4">{{ money .Order.TotalCents }}</div>
						</div>
					</div>
				</div>
			</div>

			{{ if .ShipmentTimeline }}
				<div class="card detail-card mb-4">
					<div class="card-body p-4">
						<h2 class="h5 mb-3">Shipment timeline</h2>
						<ol class="list-group list-group-numbered list-group-flush">
							{{ range .ShipmentTimeline }}
								<li class="list-group-item px-0 d-flex justify-content-between gap-3">
									<div><div class="fw-semibold">{{ .Title }}</div>{{ if .Location }}<div class="small text-muted">{{ .Location }}</div>{{ end }}</div>
									<time class="small text-muted text-nowrap" datetime="{{ .OccurredAt.Format "2006-01-02T15:04:05Z07:00" }}">{{ .OccurredAt.Format "02 Jan 15:04" }}</time>
								</li>
							{{ end }}
						</ol>
					</div>
				</div>
			{{ end }}
			{{ if .Shipment }}
				{{ if or .CanConfirmDelivery .CanRequestReturn }}
					<div class="card detail-card mb-4">
						<div class="card-body p-4">
							<h2 class="h5 mb-3">Delivery actions</h2>
							<div class="d-flex flex-wrap gap-2">
								{{ if .CanConfirmDelivery }}
									<form method="post" action="/account/orders/{{ .Order.ID }}/confirm-delivery">
										{{ .CSRFField }}
										<button class="btn btn-success" type="submit">Confirm delivery</button>
									</form>
								{{ end }}
								{{ if .CanRequestReturn }}
									<form method="post" action="/account/orders/{{ .Order.ID }}/return" class="w-100 mt-3">
										{{ .CSRFField }}
										{{ range .Order.Items }}
											<div class="input-group mb-2">
												<div class="input-group-text"><input class="form-check-input mt-0" type="checkbox" name="return_item_id" value="{{ .ID }}" aria-label="Return {{ .ProductName }}"></div>
												<span class="form-control">{{ .ProductName }}</span>
												<input class="form-control" type="number" name="return_quantity_{{ .ID }}" min="1" max="{{ .Quantity }}" value="1" aria-label="Quantity for {{ .ProductName }}">
											</div>
										{{ end }}
										<div class="d-flex flex-wrap gap-2">
											<select class="form-select" name="reason" aria-label="Return reason" required>
												<option value="" selected disabled>Return reason</option>
												<option value="damaged">Damaged</option>
												<option value="wrong_item">Wrong item</option>
												<option value="not_as_described">Not as described</option>
												<option value="does_not_fit">Does not fit</option>
												<option value="changed_mind">Changed mind</option>
												<option value="defective">Defective</option>
												<option value="other">Other</option>
											</select>
											<input class="form-control" name="note" maxlength="1000" placeholder="Optional note">
											<button class="btn btn-outline-primary" type="submit">Start return</button>
										</div>
									</form>
								{{ end }}
							</div>
						</div>
					</div>
				{{ end }}
			{{ end }}
			{{ if .ReturnShipment }}
				<div class="card detail-card mb-4">
					<div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
						<div>
							<h2 class="h5 mb-1">Return</h2>
							<div class="small text-muted">Return tracking number</div>
							<div class="fw-semibold font-monospace">{{ .ReturnShipment.TrackingNumber }}</div>
							<div class="small text-muted">{{ .ReturnShipment.StatusLabel }}</div>
						</div>
						<div class="d-flex align-items-center gap-3">
							{{ if .ReturnQRCodeURL }}<img src="{{ .ReturnQRCodeURL }}" alt="Return shipment QR code" width="96" height="96">{{ end }}
							{{ if .ReturnTrackingURL }}<a class="btn btn-outline-primary" href="{{ .ReturnTrackingURL }}">Track return</a>{{ end }}
						</div>
					</div>
				</div>
			{{ end }}
			{{ if .CanCancelOrder }}
				<div class="mb-4">
					<form method="post" action="/account/orders/{{ .Order.ID }}/cancel">
						{{ .CSRFField }}
						<button class="btn btn-outline-danger" type="submit">Cancel order</button>
					</form>
				</div>
			{{ end }}

			<div class="card detail-card">
				<div class="card-body p-4">
					<h2 class="h5 mb-3">Products</h2>
					<div class="table-responsive">
						<table class="table align-middle mb-0">
							<thead>
								<tr>
									<th scope="col">Product</th>
									<th>Unit Price</th>
									<th>Quantity</th>
									<th>Subtotal</th>
								</tr>
							</thead>
							<tbody>
								{{ range .Order.Items }}
									<tr>
										<td>
											<div class="d-flex align-items-center gap-3">
												{{ if .Product.ID }}
													<a class="order-product-link" href="/products/{{ .ProductID }}" aria-label="View {{ .ProductName }}">
														{{ if .Product.ImageFilename }}<img class="order-product-image" src="/media/products/{{ .Product.ImageFilename }}" alt="{{ .ProductName }}" loading="lazy">{{ else }}<span class="order-product-image order-product-placeholder" aria-hidden="true">{{ initials .ProductName }}</span>{{ end }}
													</a>
													<div><a class="order-product-link fw-semibold" href="/products/{{ .ProductID }}">{{ .ProductName }}</a>{{ if .ProductSKU }}<div class="small text-muted">{{ .ProductSKU }}</div>{{ end }}</div>
												{{ else }}
													<span class="order-product-image order-product-placeholder" aria-hidden="true">{{ initials .ProductName }}</span>
													<div><span class="fw-semibold">{{ .ProductName }}</span>{{ if .ProductSKU }}<div class="small text-muted">{{ .ProductSKU }}</div>{{ end }}</div>
												{{ end }}
											</div>
										</td>
										<td>{{ money .UnitPriceCents }}</td>
										<td>{{ .Quantity }}</td>
										<td>{{ money .SubtotalCents }}</td>
									</tr>
								{{ end }}
							</tbody>
						</table>
					</div>
				</div>
			</div>
			<div class="row g-4 mt-1">
				{{ range .Order.Addresses }}
					<div class="col-md-6">
						<div class="card detail-card h-100">
							<div class="card-body p-4">
								<h2 class="h5 text-capitalize">{{ .Type }} Address</h2>
								<p class="mb-0">{{ .FirstName }} {{ .LastName }}<br>{{ .Street }} {{ .HouseNumber }}<br>{{ .PostalCode }} {{ .City }}<br>{{ .CountryCode }}</p>
							</div>
						</div>
					</div>
				{{ end }}</div>
		</main>
		{{ template "site-footer" . }}
	</body>
</html>
{{ end }}
