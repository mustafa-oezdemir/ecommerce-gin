{{ define "two_factor_challenge.tmpl" }}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Two-factor check | NordShop</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #eef2ff, #f8fafc);
        }

        .card {
            border: 0;
            border-radius: 1.4rem;
            box-shadow: 0 20px 60px rgba(79, 70, 229, 0.14);
        }
    </style>
</head>

<body class="d-flex align-items-center">
    <main class="container py-5">
        <div class="card mx-auto" style="max-width: 480px;">
            <div class="card-body p-4 p-lg-5">

                <h1 class="h3">
                    Verify it is you
                </h1>

                <p class="text-muted">
                    Enter an authenticator code or one of your recovery codes.
                </p>

                {{ if .error }}
                <div class="alert alert-danger" role="alert">
                    {{ .error }}
                </div>
                {{ end }}

                <form method="post" action="/auth/two-factor-challenge">
                    {{ .CSRFField }}

                    <div class="mb-3">
                        <label for="method" class="form-label">
                            Verification method
                        </label>

                        <select
                            id="method"
                            class="form-select"
                            name="method"
                            required
                        >
                            <option value="totp">
                                Authenticator code
                            </option>
                            <option value="recovery">
                                Recovery code
                            </option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="code" class="form-label">
                            Verification code
                        </label>

                        <input
                            id="code"
                            class="form-control form-control-lg"
                            type="text"
                            name="code"
                            autocomplete="one-time-code"
                            inputmode="text"
                            required
                            autofocus
                        >
                    </div>

                    <button
                        type="submit"
                        class="btn btn-primary btn-lg w-100"
                    >
                        Continue
                    </button>
                </form>

            </div>
        </div>
    </main>
</body>
</html>
{{ end }}

