{{define "admin_dashboard.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard | PehliOne</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/site.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .stat-card { border: 0; border-radius: 1.1rem; box-shadow: 0 12px 28px rgba(15,23,42,0.08); }
  </style>
</head>
<body>
  {{template "site-nav" .}}

  <main class="app-main container py-5">
    <div class="mb-4">
      <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Summary</span>
      <h1 class="h2 mt-3 mb-0">Admin Dashboard</h1>
    </div>

    <div class="row g-4">
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Customers</span><div class="display-6 fw-bold mt-2">{{.Customers}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Employees</span><div class="display-6 fw-bold mt-2">{{.Employees}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Products</span><div class="display-6 fw-bold mt-2">{{.Products}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Total Revenue</span><div class="display-6 fw-bold mt-2">{{money .RevenueCents}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Pending Orders</span><div class="display-6 fw-bold mt-2">{{.PendingOrders}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Low Stock</span><div class="display-6 fw-bold mt-2">{{.LowStock}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Total Orders</span><div class="display-6 fw-bold mt-2">{{.TotalOrders}}</div></div></div></div>
    </div>
  </main>
  {{template "site-footer" .}}
</body>
</html>
{{end}}
