{{define "admin_dashboard.tmpl"}}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Yönetici Paneli | NordShop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .stat-card { border: 0; border-radius: 1.1rem; box-shadow: 0 12px 28px rgba(15,23,42,0.08); }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/admin">Yönetici Paneli</a>
      <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/admin/users">Kullanıcılar</a>
        <a class="btn btn-outline-light btn-sm" href="/admin/orders">Siparişler</a>
        <a class="btn btn-outline-light btn-sm" href="/admin/categories">Kategoriler</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="mb-4">
      <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Özet</span>
      <h1 class="h2 mt-3 mb-0">Yönetici paneli</h1>
    </div>

    <div class="row g-4">
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Müşteriler</span><div class="display-6 fw-bold mt-2">{{.Customers}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Çalışanlar</span><div class="display-6 fw-bold mt-2">{{.Employees}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Ürünler</span><div class="display-6 fw-bold mt-2">{{.Products}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Toplam gelir</span><div class="display-6 fw-bold mt-2">{{money .RevenueCents}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Bekleyen siparişler</span><div class="display-6 fw-bold mt-2">{{.PendingOrders}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Düşük stok</span><div class="display-6 fw-bold mt-2">{{.LowStock}}</div></div></div></div>
      <div class="col-md-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><span class="text-muted small">Toplam sipariş</span><div class="display-6 fw-bold mt-2">{{.TotalOrders}}</div></div></div></div>
    </div>
  </main>
</body>
</html>
{{end}}}
