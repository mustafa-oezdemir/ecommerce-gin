{{define "cart.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Cart | NordShop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .summary-card { border: 0; border-radius: 1.25rem; box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08); }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">NordShop</a>
      <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/">Products</a>
        <a class="btn btn-outline-light btn-sm" href="/cart">Cart</a>
        <a class="btn btn-outline-light btn-sm" href="/account">My Account</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Cart</span>
        <h1 class="h2 mt-3 mb-0">Your Cart</h1>
      </div>
      <a href="/" class="btn btn-outline-secondary">Back to Shopping</a>
    </div>

    {{if .Items}}
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card summary-card">
          <div class="card-body p-4">
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {{range .Items}}
                  <tr>
                    <td>
                      <div class="fw-semibold">{{.Product.Name}}</div>
                      <small class="text-muted">{{if .Product.Category}}{{.Product.Category.Name}}{{else}}Category{{end}}</small>
                    </td>
                    <td>{{money .Product.PriceCents}}</td>
                    <td>
                      <form method="post" action="/cart/items/{{.ID}}" class="d-flex gap-2 align-items-center">
                        {{$.CSRFField}}
                        <input class="form-control" type="number" name="quantity" value="{{.Quantity}}" min="1" max="100" style="max-width: 90px;">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                      </form>
                    </td>
                    <td>{{money (mulCents .Product.PriceCents .Quantity)}}</td>
                    <td>
                      <form method="post" action="/cart/items/{{.ID}}/remove">
                        {{$.CSRFField}}
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                      </form>
                    </td>
                  </tr>
                  {{end}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card summary-card">
          <div class="card-body p-4">
            <h2 class="h5 mb-3">Order Summary</h2>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Subtotal</span>
              <span>{{money .TotalCents}}</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Shipping</span>
              <span>Free</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between fw-bold fs-5">
              <span>Total</span>
              <span>{{money .TotalCents}}</span>
            </div>
            <form method="post" action="/checkout" class="mt-4">
              {{.CSRFField}}
              <button type="submit" class="btn btn-primary btn-lg w-100">Proceed to Checkout</button>
            </form>
          </div>
        </div>
      </div>
    </div>
    {{else}}
    <div class="alert alert-light border text-center py-5">
      <h2 class="h4 mb-2">Your Cart is Empty</h2>
      <p class="text-muted mb-3">You haven't added any products yet.</p>
      <a href="/" class="btn btn-primary">View Products</a>
    </div>
    {{end}}
  </main>
</body>
</html>
{{end}}
