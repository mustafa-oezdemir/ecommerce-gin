{{define "admin_logs.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{if .AutoRefresh}}<meta http-equiv="refresh" content="10">{{end}}
  <title>Application Logs | NordShop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { min-height: 100vh; background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); color: #172033; }
    .panel-card, .metric-card { border: 0; border-radius: 1.2rem; box-shadow: 0 12px 30px rgba(15,23,42,.08); }
    .metric-value { font-size: 1.8rem; font-weight: 750; letter-spacing: -.04em; }
    .log-stream { display: grid; gap: .8rem; }
    .log-entry { border: 1px solid #e8edf5; border-left: 4px solid var(--bs-primary); border-radius: 1rem; background: #fff; padding: 1rem 1.1rem; }
    .log-entry.level-warning { border-left-color: var(--bs-warning); }
    .log-entry.level-danger { border-left-color: var(--bs-danger); }
    .log-entry.level-secondary { border-left-color: var(--bs-secondary); }
    .log-message { font-weight: 650; overflow-wrap: anywhere; }
    .attribute { display: inline-flex; gap: .35rem; max-width: 100%; margin: .25rem .25rem 0 0; padding: .32rem .55rem; border-radius: .55rem; background: #f1f5f9; color: #334155; font: .78rem/1.3 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    .attribute span:last-child { overflow-wrap: anywhere; }
    .filter-bar { position: sticky; top: 1rem; z-index: 2; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/admin/dashboard">Admin</a>
      <div class="d-flex flex-wrap gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/admin/users">Users</a>
        <a class="btn btn-outline-light btn-sm" href="/admin/orders">Orders</a>
        <a class="btn btn-outline-light btn-sm" href="/admin/categories">Categories</a>
        <a class="btn btn-light btn-sm" href="/admin/logs" aria-current="page">Logs</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
      <div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Operations</span>
        <h1 class="h2 mt-3 mb-1">Application Logs</h1>
        <p class="text-muted mb-0">Structured events from the application log. Times are displayed in UTC.</p>
      </div>
      {{if .AutoRefresh}}
      <a class="btn btn-outline-secondary" href="/admin/logs?level={{.Level}}&amp;limit={{.Limit}}&amp;q={{.Search}}">Pause auto-refresh</a>
      {{else}}
      <a class="btn btn-outline-primary" href="/admin/logs?level={{.Level}}&amp;limit={{.Limit}}&amp;q={{.Search}}&amp;refresh=10">Auto-refresh every 10s</a>
      {{end}}
    </div>

    <div class="row g-3 mb-4">
      <div class="col-6 col-lg"><div class="card metric-card h-100"><div class="card-body"><div class="text-muted small">Scanned</div><div class="metric-value">{{.Snapshot.Scanned}}</div></div></div></div>
      <div class="col-6 col-lg"><div class="card metric-card h-100"><div class="card-body"><div class="text-muted small">Info</div><div class="metric-value text-primary">{{.Snapshot.InfoCount}}</div></div></div></div>
      <div class="col-6 col-lg"><div class="card metric-card h-100"><div class="card-body"><div class="text-muted small">Warnings</div><div class="metric-value text-warning">{{.Snapshot.WarnCount}}</div></div></div></div>
      <div class="col-6 col-lg"><div class="card metric-card h-100"><div class="card-body"><div class="text-muted small">Errors</div><div class="metric-value text-danger">{{.Snapshot.ErrorCount}}</div></div></div></div>
      <div class="col-12 col-lg"><div class="card metric-card h-100"><div class="card-body"><div class="text-muted small">Log file</div><div class="metric-value">{{.Snapshot.FileSizeText}}</div><div class="small text-muted">Updated {{.Snapshot.LastModified}}</div></div></div></div>
    </div>

    <section class="card panel-card filter-bar mb-4">
      <div class="card-body p-3 p-lg-4">
        <form method="get" action="/admin/logs" class="row g-3 align-items-end">
          <div class="col-md-3">
            <label class="form-label" for="log-level">Level</label>
            <select class="form-select" id="log-level" name="level">
              <option value="all" {{if eq .Level "all"}}selected{{end}}>All levels</option>
              <option value="debug" {{if eq .Level "debug"}}selected{{end}}>Debug</option>
              <option value="info" {{if eq .Level "info"}}selected{{end}}>Info</option>
              <option value="warn" {{if eq .Level "warn"}}selected{{end}}>Warning</option>
              <option value="error" {{if eq .Level "error"}}selected{{end}}>Error</option>
            </select>
          </div>
          <div class="col-md-5">
            <label class="form-label" for="log-search">Search</label>
            <input class="form-control" id="log-search" name="q" value="{{.Search}}" maxlength="100" placeholder="Message, route, request ID…">
          </div>
          <div class="col-md-2">
            <label class="form-label" for="log-limit">Entries</label>
            <select class="form-select" id="log-limit" name="limit">
              <option value="50" {{if eq .Limit 50}}selected{{end}}>50</option>
              <option value="100" {{if eq .Limit 100}}selected{{end}}>100</option>
              <option value="200" {{if eq .Limit 200}}selected{{end}}>200</option>
              <option value="500" {{if eq .Limit 500}}selected{{end}}>500</option>
            </select>
          </div>
          {{if .AutoRefresh}}<input type="hidden" name="refresh" value="10">{{end}}
          <div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Apply filters</button></div>
        </form>
      </div>
    </section>

    {{if .Snapshot.Partial}}<div class="alert alert-info border-0 shadow-sm">For performance, this view scans only the newest 2 MB of the log file.</div>{{end}}

    <section class="log-stream" aria-live="polite">
      {{range .Snapshot.Entries}}
      <article class="log-entry level-{{.LevelClass}}">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
          <span class="badge text-bg-{{.LevelClass}}">{{.Level}}</span>
          <time class="small text-muted">{{.Time}}</time>
        </div>
        <div class="log-message">{{.Message}}</div>
        {{if .Attributes}}<div class="mt-2">{{range .Attributes}}<span class="attribute"><strong>{{.Name}}</strong><span>{{.Value}}</span></span>{{end}}</div>{{end}}
      </article>
      {{else}}
      <div class="card panel-card"><div class="card-body p-5 text-center"><h2 class="h5">No matching log entries</h2><p class="text-muted mb-0">Try a different level, search term, or entry limit.</p></div></div>
      {{end}}
    </section>
  </main>
</body>
</html>
{{end}}
