{{define "employee_orders.tmpl"}}<!doctype html><html><body><h1>Sipariş işlemleri</h1><table><tr><th>ID</th><th>Kullanıcı</th><th>Durum</th><th>İşlem</th></tr>{{range .Orders}}<tr><td>{{.ID}}</td><td>{{.User.Email}}</td><td>{{.Status}}</td><td><form method="post" action="/employee/orders/{{.ID}}/status">{{$.CSRFField}}<select name="status"><option value="processing">processing</option><option value="shipped">shipped</option><option value="completed">completed</option><option value="cancelled">cancelled</option></select><button type="submit">Durumu güncelle</button></form></td></tr>{{end}}</table></body></html>{{end}}
