{{define "order_list.tmpl"}}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Siparişlerim | NordShop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%); }
    .order-card { border: 0; border-radius: 1.25rem; box-shadow: 0 12px 30px rgba(15,23,42,0.08); }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">NordShop</a>
      <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-outline-light btn-sm" href="/">Ürünler</a>
        <a class="btn btn-outline-light btn-sm" href="/cart">Sepet</a>
        <a class="btn btn-outline-light btn-sm" href="/account">Hesabım</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Siparişler</span>
        <h1 class="h2 mt-3 mb-0">Siparişlerim</h1>
      </div>
      <a href="/account" class="btn btn-outline-secondary">Hesaba dön</a>
    </div>

    {{if .Orders}}
    <div class="row g-3">
      {{range .Orders}}
      <div class="col-12">
        <div class="card order-card">
          <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 p-4">
            <div>
              <div class="text-muted small">Sipariş #{{.ID}}</div>
              <div class="fw-semibold mt-1">{{.Status}}</div>
            </div>
            <div class="text-md-end">
              <div class="fw-bold fs-5">{{money .TotalCents}}</div>
              <a href="/account/orders/{{.ID}}" class="btn btn-outline-primary btn-sm mt-2">Detay görüntüle</a>
            </div>
          </div>
        </div>
      </div>
      {{end}}
    </div>
    {{else}}
    <div class="alert alert-light border text-center py-5">
      <h2 class="h4 mb-2">Henüz siparişiniz yok</h2>
      <p class="text-muted mb-3">İlk siparişinizi oluşturmak için ürünleri keşfedin.</p>
      <a href="/" class="btn btn-primary">Alışverişe başla</a>
    </div>
    {{end}}
  </main>
</body>
</html>
{{end}}
