{{ define "content" }}
<h1>Orders</h1>

<table>
  <tr>
    <th>ID</th>
    <th>User</th>
    <th>Status</th>
    <th>Items</th>
  </tr>

  {{ range .Orders }}
  <tr>
    <td>{{ .ID }}</td>
    <td>{{ .User.Email }}</td>
    <td>{{ .Status }}</td>
    <td>
      <ul>
        {{ range .Items }}
        <li>{{ .Product.Name }} × {{ .Quantity }}</li>
        {{ end }}
      </ul>
    </td>
  </tr>
  {{ end }}
</table>
{{ end }}

{{ template "layout" . }}
